# Copie para orquestracao/.env na VM de processamento. Nunca vai para o Git.
#
# AIRFLOW_UID: id -u do usuario ubuntu (os logs ficam com o dono certo)
# DOCKER_GID:  getent group docker | cut -d: -f3
# Senhas e chaves: gere com
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# FERNET_KEY tem formato proprio:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_UID=1000
DOCKER_GID=
POSTGRES_SENHA=
FERNET_KEY=
JWT_SECRET=
ADMIN_USUARIO=admin
ADMIN_SENHA=
