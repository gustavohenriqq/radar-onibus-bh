/// Histograma do intervalo dividido pelo intervalo medio, por dia (classes de 0,05; a 80 junta 4 ou mais).
table fato_hist
	lineageTag: 587cc255-8f80-5e91-8020-e22f51de0989

	column data_bh
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 92e0ee47-e3d6-5ea3-aff8-c1a61425eb40
		summarizeBy: none
		sourceColumn: data_bh

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	column tipo_dia
		dataType: string
		lineageTag: 4c2c6814-4c60-5864-a641-e2102a44ef3d
		summarizeBy: none
		sourceColumn: tipo_dia

		annotation SummarizationSetBy = User

	column alta_frequencia
		dataType: boolean
		isHidden
		lineageTag: 8c98cea7-e8e9-5845-a008-1a252fed91d2
		summarizeBy: none
		sourceColumn: alta_frequencia

		annotation SummarizationSetBy = User

	column classe
		dataType: int64
		formatString: 0
		lineageTag: 77aa9846-c75a-5a83-9797-d610e588f850
		summarizeBy: none
		sourceColumn: classe

		annotation SummarizationSetBy = User

	column headways
		dataType: int64
		formatString: 0
		lineageTag: 5c039f7f-07db-5af6-a6b5-d5659d9fb2f4
		summarizeBy: none
		sourceColumn: headways

		annotation SummarizationSetBy = User

	column frequencia
		dataType: string
		lineageTag: 5f783580-45fa-5f8f-a76a-d6e11cfde1c0
		summarizeBy: none
		sourceColumn: frequencia

		annotation SummarizationSetBy = User

	partition fato_hist = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(ServidorPostgres, BancoPostgres),
				    Tabela = Fonte{[Schema = "radar", Item = "hist_dia"]}[Data],
				    Selecao = Table.SelectColumns(Tabela, {"data_bh", "tipo_dia", "alta_frequencia", "classe", "headways"}),
				    Colunas = Table.TransformColumnTypes(Selecao, {{"data_bh", type date}, {"tipo_dia", type text}, {"alta_frequencia", type logical}, {"classe", Int64.Type}, {"headways", Int64.Type}}),
				    Freq = Table.AddColumn(Colunas, "frequencia", each if [alta_frequencia] then "alta" else "baixa", type text),
				    Pronto = Freq
				in
				    Pronto

	annotation PBI_ResultType = Table
