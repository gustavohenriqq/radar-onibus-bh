	partition fato_paradas = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(ServidorPostgres, BancoPostgres),
				    Tabela = Fonte{[Schema = "radar", Item = "paradas_28d"]}[Data],
				    Selecao = Table.SelectColumns(Tabela, {"stop_id", "tipo_dia", "alta_frequencia", "grupos", "n", "soma", "soma2_n", "dev2", "colados", "abaixo_60s", "reducao", "pares", "pulo_primeiro", "pulo_colado", "var_n", "linhas", "stop_name", "stop_lat", "stop_lon", "janela_ini", "janela_fim"}),
				    Colunas = Table.TransformColumnTypes(Selecao, {{"stop_id", type text}, {"tipo_dia", type text}, {"alta_frequencia", type logical}, {"grupos", Int64.Type}, {"n", Int64.Type}, {"soma", type number}, {"soma2_n", type number}, {"dev2", type number}, {"colados", Int64.Type}, {"abaixo_60s", Int64.Type}, {"reducao", type number}, {"pares", Int64.Type}, {"pulo_primeiro", Int64.Type}, {"pulo_colado", Int64.Type}, {"var_n", type number}, {"linhas", Int64.Type}, {"stop_name", type text}, {"stop_lat", type number}, {"stop_lon", type number}, {"janela_ini", type date}, {"janela_fim", type date}}),
				    Freq = Table.AddColumn(Colunas, "frequencia", each if [alta_frequencia] then "alta" else "baixa", type text),
				    Pronto = Freq
				in
				    Pronto

	annotation PBI_ResultType = Table
