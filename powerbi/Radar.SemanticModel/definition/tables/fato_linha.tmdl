	partition fato_linha = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(ServidorPostgres, BancoPostgres),
				    Tabela = Fonte{[Schema = "radar", Item = "linha_dia_faixa"]}[Data],
				    Selecao = Table.SelectColumns(Tabela, {"route_id", "direction_id", "data_bh", "faixa_horaria", "ordem_faixa", "tipo_dia", "alta_frequencia", "grupos", "n", "soma", "soma2_n", "dev2", "colados", "abaixo_60s", "reducao", "pares", "pulo_primeiro", "pulo_colado", "var_n"}),
				    Colunas = Table.TransformColumnTypes(Selecao, {{"route_id", type text}, {"direction_id", Int64.Type}, {"data_bh", type date}, {"faixa_horaria", type text}, {"ordem_faixa", Int64.Type}, {"tipo_dia", type text}, {"alta_frequencia", type logical}, {"grupos", Int64.Type}, {"n", Int64.Type}, {"soma", type number}, {"soma2_n", type number}, {"dev2", type number}, {"colados", Int64.Type}, {"abaixo_60s", Int64.Type}, {"reducao", type number}, {"pares", Int64.Type}, {"pulo_primeiro", Int64.Type}, {"pulo_colado", Int64.Type}, {"var_n", type number}}),
				    Freq = Table.AddColumn(Colunas, "frequencia", each if [alta_frequencia] then "alta" else "baixa", type text),
				    Pronto = Freq
				in
				    Pronto

	annotation PBI_ResultType = Table
