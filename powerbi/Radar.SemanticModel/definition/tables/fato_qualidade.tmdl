				    Tabela = Fonte{[Schema = "radar", Item = "qualidade_diaria"]}[Data],
				    Selecao = Table.SelectColumns(Tabela, {"data_bh", "passagens", "passagens_validas", "headways", "headways_validos", "headways_feed_parado", "linhas", "cobertura_passagens"}),
				    Colunas = Table.TransformColumnTypes(Selecao, {{"data_bh", type date}, {"passagens", Int64.Type}, {"passagens_validas", Int64.Type}, {"headways", Int64.Type}, {"headways_validos", Int64.Type}, {"headways_feed_parado", Int64.Type}, {"linhas", Int64.Type}, {"cobertura_passagens", type number}}),
