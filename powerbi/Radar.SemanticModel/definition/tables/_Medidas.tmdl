			    & "</text><line x1='738' x2='738' y1='0' y2='80' stroke='#2A3456'/><text x='772' y='18' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>JANELA</text><text x='770' y='70' font-size='40' font-weight='700' fill='#C9D0E4'>"
