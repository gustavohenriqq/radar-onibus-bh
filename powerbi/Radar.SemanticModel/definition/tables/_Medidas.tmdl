			    & ( FORMAT ( [@p], "0.0%" ) )
			    & "</text><rect x='560' y='"
			    & ( FORMAT ( y + 14, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@e] / emax * 130, "0.0", "en-US" ) )
			    & "' height='14' rx='3' fill='#FFB347'/><text x='"
			    & ( FORMAT ( 566 + [@e] / emax * 130, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 26, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [@e], "0.00" ) )
			    & "</text><text x='824' y='"
			    & ( FORMAT ( y + 25, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#FF6B6B' text-anchor='end'>"
			    & ( FORMAT ( [@c], "0.0%" ) )
