			    "<div style='width:100%;height:100%;overflow:hidden;box-sizing:border-box;border-radius:24px;border:1px solid color-mix(in srgb, #FF6B6B 16%, rgba(148,163,255,.10));background:linear-gradient(180deg, color-mix(in srgb, #FF6B6B 8%, #111729), #111729 110px);box-shadow:inset 0 1px 0 color-mix(in srgb, #FF6B6B 30%, transparent)'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1768 206' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='34' y='52' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>INTERVALOS COLADOS</text><text x='32' y='126' font-size='64' font-weight='700' fill='#FF6B6B'>"
			    & ( FORMAT ( [Colados], "0.0%" ) )
			    & "</text><text x='34' y='162' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>menos de 1/4 do intervalo médio</text><line x1='438' x2='438' y1='30' y2='170' stroke='#2A3456'/><text x='472' y='52' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>ABAIXO DE 60 SEGUNDOS</text><text x='470' y='126' font-size='64' font-weight='700' fill='#FF6B6B'>"
			    & ( FORMAT ( [Abaixo de 60 s], "0.0%" ) )
			    & "</text><text x='472' y='162' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>dos intervalos: praticamente juntos</text><line x1='876' x2='876' y1='30' y2='170' stroke='#2A3456'/><text x='910' y='52' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>COMBOIOS</text><text x='908' y='126' font-size='64' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [Colados atrás de colado %], "0%" ) )
			    & "</text><text x='910' y='162' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>dos colados são o 3º ônibus em diante</text><line x1='1314' x2='1314' y1='30' y2='170' stroke='#2A3456'/><text x='1348' y='52' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>CORTE SEM COLAGEM</text><text x='1346' y='126' font-size='64' font-weight='700' fill='#42D392'>"
			    & ( FORMAT ( [Corte sem colagem], "0%" ) )
			    & "</text><text x='1348' y='162' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>da espera extra sumiria sem colagem</text>"
			    & "</svg></div>" )
		displayFolder: HTML
