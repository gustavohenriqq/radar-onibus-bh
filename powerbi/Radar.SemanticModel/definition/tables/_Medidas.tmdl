		lineageTag: d5efc6a6-9eb2-5b0d-91ee-3251f1c02f31

	/// Dias com algum intervalo descartado por feed parado.
	measure 'Dias com feed parado' = COUNTROWS ( FILTER ( VALUES ( dim_data[data] ), [Feed parado] > 0 ) )
		formatString: 0
		displayFolder: Qualidade
		lineageTag: 55fbf492-cb9d-5348-a7fb-a7fbe0221e60

	/// Dias com medida de qualidade no recorte.
	measure 'Dias com qualidade' = COUNTROWS ( FILTER ( VALUES ( dim_data[data] ), NOT ISBLANK ( [Passagens] ) ) )
		formatString: 0
		displayFolder: Qualidade
		lineageTag: 67de0101-bfaf-507a-9606-656a4b24c768

	/// Vies de interpolacao em minutos e em parte da espera extra.
	measure 'Viés texto' = IF ( NOT ISBLANK ( [Viés de interpolação] ), FORMAT ( [Viés de interpolação], "0.000" ) & " min · " & FORMAT ( [Viés de interpolação %], "0.0%" ) )
		displayFolder: Qualidade
		lineageTag: 84eca09c-3da9-5266-8b06-6d82e2f41f54

	/// Parte dos pares colados que o controle conseguiria espacar (padrao 50%).
	measure 'Espaçamento' = SELECTEDVALUE ( sel_espacamento[espacamento], 0.5 )
		formatString: 0%
		displayFolder: Simulador
		lineageTag: a050b687-6877-5641-9c1b-3a24aa4f97ba

	/// Espera extra se essa parte dos pares colados passasse no meio do caminho.
	measure 'Espera extra simulada' = DIVIDE ( SUM ( fato_linha[dev2] ) - [Espaçamento] * SUM ( fato_linha[reducao] ), SUM ( fato_linha[soma] ) ) / 2 / 60
		formatString: 0.00
		displayFolder: Simulador
		lineageTag: e8ec6d92-be98-5acd-87f3-0f5851b87faa

	/// Minutos a menos de espera por ida ao ponto.
	measure 'Ganho por passageiro' = [Espera extra] - [Espera extra simulada]
		formatString: 0.00
		displayFolder: Simulador
		lineageTag: 5a431cc2-fb77-5ba5-85f6-0f03f419bbc3

	/// Ganho sobre a espera media no ponto.
	measure 'Ganho % da espera' = DIVIDE ( [Ganho por passageiro], [Espera média] )
		formatString: 0.0%
		displayFolder: Simulador
		lineageTag: d1b942dd-3b85-57d4-b555-d7261672fa3d

	/// Espera media simulada.
	measure 'Espera média simulada' = [Espera regular] + [Espera extra simulada]
		formatString: 0.00
		displayFolder: Simulador
		lineageTag: e36c8ae6-451e-5f6e-a4cf-d16abf338068

	/// Volume de espera extra que sai (min x h).
	measure 'Volume poupado' = [Espaçamento] * SUM ( fato_linha[reducao] ) / 2 / 60 / 3600
		formatString: #,0
		displayFolder: Simulador
		lineageTag: 87971b4f-9529-52ab-8ed2-9ca71831a824

	/// Parte do ganho da rede que vem da linha.
	measure 'Parte do ganho' = DIVIDE ( [Volume poupado], CALCULATE ( [Volume poupado], REMOVEFILTERS ( dim_linha ) ) )
		formatString: 0.0%
		displayFolder: Simulador
		lineageTag: 3e4a459d-17ba-5417-8de7-22f7c6628450

	/// Frase do simulador.
	measure 'Texto do simulador' =
			"Espaçando " & FORMAT ( [Espaçamento], "0%" ) & " dos pares colados, a espera extra cai de "
			    & FORMAT ( [Espera extra], "0.00" ) & " para " & FORMAT ( [Espera extra simulada], "0.00" ) & " min"
		displayFolder: Simulador
		lineageTag: ed369b43-51cf-5284-92f6-bc54a645ce43

	/// Minutos a menos por ida ao ponto se todos os pares colados fossem espacados (o simulador em 100%).
	measure 'Ganho sem colagem' = [Espera extra] * [Corte sem colagem]
		formatString: 0.00
		displayFolder: Onde agir
		lineageTag: 5e03f85d-f2d3-5646-a289-42e7fd4ef34c

	/// Espera extra da rede inteira no recorte, sem o filtro de linha.
	measure 'Espera extra da rede no recorte' = CALCULATE ( [Espera extra], REMOVEFILTERS ( dim_linha ) )
		formatString: 0.00
		displayFolder: Onde agir
		lineageTag: 3f0cedb7-2cbb-58c6-910b-1cc3d57a3e0c

	/// Capa da visao geral: espera extra, frase, variacao e ilustracao.
	measure 'HTML capa' =
			VAR ee = [Espera extra]
			VAR er = [Espera regular]
			VAR em = ee + er
			VAR d = [Δ espera extra]
			VAR corv = IF ( d > 0, "#FF6B6B", IF ( d < 0, "#42D392", "#C9D0E4" ) )
			VAR wr = DIVIDE ( er, em ) * 372
			RETURN
			    IF ( ISBLANK ( ee ), "<div style='width:100%;height:100%;box-sizing:border-box;border-radius:24px;border:1px solid color-mix(in srgb, #FFB347 16%, rgba(148,163,255,.10));background:linear-gradient(180deg, color-mix(in srgb, #FFB347 8%, #111729), #111729 110px);box-shadow:inset 0 1px 0 color-mix(in srgb, #FFB347 30%, transparent)'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1100 400' width='100%' height='100%'><text x='550' y='200' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;box-sizing:border-box;border-radius:24px;border:1px solid color-mix(in srgb, #FFB347 16%, rgba(148,163,255,.10));background:linear-gradient(180deg, color-mix(in srgb, #FFB347 8%, #111729), #111729 110px);box-shadow:inset 0 1px 0 color-mix(in srgb, #FFB347 30%, transparent)'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1116 416' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='44' y='62' font-size='17' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='2.6'>ESPERA EXTRA POR IDA AO PONTO</text><text x='668' y='146' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.8'>OS MESMOS ÔNIBUS, DE DOIS JEITOS</text><text x='668' y='178' font-size='15' font-weight='700' fill='#FFB347' text-anchor='start' letter-spacing='1.6'>HOJE: EM GRUPOS</text><clipPath id='pista178'><rect x='668' y='188' width='372' height='50' rx='12'/></clipPath><rect x='668' y='188' width='372' height='50' rx='12' fill='#0A0E1C' stroke='#2A3456'/><line x1='676' x2='1032' y1='213' y2='213' stroke='#2A3456' stroke-width='2' stroke-dasharray='14 12'/><rect x='899' y='188' width='3' height='50' fill='#F4F6FB' fill-opacity='.8'/><g clip-path='url(#pista178)'><g><g transform='translate(296.0,198) scale(1.15)'><rect width='27' height='17' rx='4' fill='#FFB347'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(668.0,198) scale(1.15)'><rect width='27' height='17' rx='4' fill='#FFB347'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(329.5,198) scale(1.15)'><rect width='27' height='17' rx='4' fill='#FFB347'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(701.5,198) scale(1.15)'><rect width='27' height='17' rx='4' fill='#FFB347'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='trans