	/// Histograma do intervalo dividido pelo medio.
	measure 'HTML histograma' =
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_classe[classe] ), "@p", [% dos intervalos] ), NOT ISBLANK ( [@p] ) )
			VAR mx = MAXX ( t, [@p] )
			VAR passo = IF ( mx > 0.06, 0.02, IF ( mx > 0.03, 0.01, 0.005 ) )
			VAR topo = CEILING ( mx * 1.1 / passo, 1 ) * passo
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1048 564' width='100%' height='100%'><text x='524' y='282' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1064 580' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<rect x='0' y='6' width='15' height='15' rx='3' fill='#FF6B6B'/><text x='23' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>colados: menos de 1/4 do intervalo médio</text><rect x='353' y='6' width='15' height='15' rx='3' fill='#6AA8FF'/><text x='376' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>demais intervalos</text><line x1='534' x2='562' y1='13' y2='13' stroke='#F4F6FB' stroke-width='2.5' stroke-dasharray='7 5'/><text x='570' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>intervalo igual ao médio</text><rect x='64' y='50' width='59.9' height='440' fill='#FF6B6B' fill-opacity='.08'/><text x='70' y='67' font-size='13' font-weight='700' fill='#FF6B6B' text-anchor='start' letter-spacing='1.2'>COLADOS</text><line x1='309.5' x2='309.5' y1='50' y2='490' stroke='#F4F6FB' stroke-opacity='.75' stroke-dasharray='7 5' stroke-width='2'/><text x='317' y='67' font-size='13' font-weight='700' fill='#F4F6FB' text-anchor='start' letter-spacing='1.2'>INTERVALO MÉDIO</text><line x1='64' x2='1034' y1='490' y2='490' stroke='#9AA3C2'/><text x='54' y='495' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='end'>0</text><text x='70' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>0</text><line x1='70.0' x2='70.0' y1='490' y2='497' stroke='#9AA3C2'/><text x='130' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>0,25</text><line x1='129.9' x2='129.9' y1='490' y2='497' stroke='#9AA3C2'/><text x='190' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>0,5</text><line x1='189.7' x2='189.7' y1='490' y2='497' stroke='#9AA3C2'/><text x='309' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>1</text><line x1='309.5' x2='309.5' y1='490' y2='497' stroke='#9AA3C2'/><text x='429' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>1,5</text><line x1='429.2' x2='429.2' y1='490' y2='497' stroke='#9AA3C2'/><text x='549' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>2</text><line x1='549.0' x2='549.0' y1='490' y2='497' stroke='#9AA3C2'/><text x='789' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>3</text><line x1='788.5' x2='788.5' y1='490' y2='497' stroke='#9AA3C2'/><text x='1028' y='516' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle'>4 ou mais</text><line x1='1028.0' x2='1028.0' y1='490' y2='497' stroke='#9AA3C2'/><text x='549' y='550' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>tamanho do intervalo dividido pelo intervalo médio do grupo (1 = igual ao médio)</text>"
			    & ( CONCATENATEX ( GENERATESERIES ( 1, ROUND ( topo / passo, 0 ), 1 ), VAR v = [Value] * passo VAR yg = 490 - v / topo * 414 RETURN "<line x1='64' x2='1034' y1='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' stroke='#2A3456' stroke-dasharray='4 6'/><text x='54' y='"
			    & ( FORMAT ( yg + 5, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( v, IF ( passo < 0.01, "0.0%", "0%" ) ) )
			    & "</text>", "" ) )
			    & ( CONCATENATEX ( t, VAR hb = [@p] / topo * 414 RETURN "<rect x='"
			    & ( FORMAT ( 64 + dim_classe[classe] * 11.9753 + 1.44, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 490 - hb, "0.0", "en-US" ) )
			    & "' width='9.10' height='"
			    & ( FORMAT ( hb, "0.0", "en-US" ) )
			    & "' rx='1.5' fill='"
			    & ( IF ( dim_classe[classe] < 5, "#FF6B6B", "#6AA8FF" ) )
			    & "'/>", "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: a4a2124d-7c8a-5fca-b7b6-2d5cbb6612ae

	/// Colados por faixa horaria.
	measure 'HTML colados faixa' =
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_faixa[faixa], dim_faixa[ordem] ), "@c", [Colados] ), NOT ISBLANK ( [@c] ) )
			VAR topo = MAXX ( t, [@c] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 584 218' width='100%' height='100%'><text x='292' y='109' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 234' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( t, VAR y = ( dim_faixa[ordem] - 1 ) * 36.33 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 24.2, "0.0", "en-US" ) )
			    & "' font-size='16' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( dim_faixa[faixa] )
			    & "</text><rect x='168' y='"
			    & ( FORMAT ( y + 10.2, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@c] / topo * 332, "0.0", "en-US" ) )
			    & "' height='16' rx='4' fill='#FF6B6B'/><text x='584' y='"
			    & ( FORMAT ( y + 24.2, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='700' fill='#FF6B6B' text-anchor='end'>"
			    & ( FORMAT ( [@c], "0.0%" ) )
			    & "</text>", "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: d7172e24-7980-52e2-8cfe-814db7c0a735

	/// Linhas com mais intervalos colados.
	measure 'HTML colados linhas' =
			VAR t = TOPN ( 5, FILTER ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@n", [Intervalos colados],
			        "@c", [Colados], "@nome", CALCULATE ( MAX ( dim_linha[route_long_name] ) ) ), [@n] > 0 ),
			        [@n], DESC, dim_linha[route_id], ASC )
			VAR r = ADDCOLUMNS ( t, "@k", VAR _v = [@n] VAR _c = dim_linha[route_id] RETURN COUNTROWS ( FILTER ( t, [@n] > _v || ( [@n] = _v && dim_linha[route_id] < _c ) ) ) + 1 )
			VAR topo = MAXX ( t, [@n] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 584 218' width='100%' height='100%'><text x='292' y='109' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 234' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( r, VAR y = ( [@k] - 1 ) * 43.60 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 20, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#F4F6FB'>"
			    & ( dim_linha[route_id] )
			    & "</text><text x='76' y='"
			    & ( FORMAT ( y + 20, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( LEN ( [@nome] ) > 44, LEFT ( [@nome], 43 ) & "…", [@nome] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='584' y='"
			    & ( FORMAT ( y + 20, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#FF6B6B' text-anchor='end'>"
			    & ( FORMAT ( [@n], "#,0" ) )
			    & "</text><rect x='0' y='"
			    & ( FORMAT ( y + 29, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@n] / topo * 384, "0.0", "en-US" ) )
			    & "' height='9' rx='3' fill='#FF6B6B'/><text x='584' y='"
			    & ( FORMAT ( y + 40, "0.0", "en-US" ) )
			    & "' font-size='14' fill='#C9D0E4' text-anchor='end'>"
			    & ( FORMAT ( [@c], "0.0%" ) )
			    & " dos intervalos</text>", "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 08d56a57-79bf-5f77-8b9d-088411dade14

	/// Acerto dos alertas contra a chance sem modelo.
	measure 'HTML previsão capa' =
			VAR ac = [Acerto dos alertas]
			VAR ch = [Chance sem modelo]
			RETURN
			    IF ( ISBLANK ( ac ), "<div style='width:100%;height:100%;box-sizing:border-box;border-radius:24px;border:1px solid color-mix(in srgb, #42D392 16%, rgba(148,163,255,.10));background:linear-gradient(180deg, color-mix(in srgb, #42D392 8%, #111729), #111729 110px);box-shadow:inset 0 1px 0 color-mix(in srgb, #42D392 30%, transparent)'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1100 420' width='100%' height='100%'><text x='550' y='210' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem alerta do modelo no recorte</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;box-sizing:border-box;border-radius:24px;border:1px solid color-mix(in srgb, #42D392 16%, rgba(148,163,255,.10));background:linear-gradient(180deg, color-mix(in srgb, #42D392 8%, #111729), #111729 110px);box-shadow:inset 0 1px 0 color-mix(in srgb, #42D392 30%, transparent)'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1116 436' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='44' y='62' font-size='17' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='2.6'>ACERTO DOS ALERTAS</text><text x='44' y='290' font-size='24' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>dos alertas chegaram <tspan fill='#42D392'>colados</tspan> de fato</text><text x='44' y='322' font-size='22' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>testado uma vez, em dias que o modelo não tinha visto</text><rect x='44' y='346' width='500' height='38' rx='19' fill='#42D392' fill-opacity='.14' stroke='#42D392'/><text x='66' y='371' font-size='18' font-weight='600' fill='#42D392' text-anchor='start' font-family='Segoe UI, sans-serif'>Uso sugerido: lista de prioridade para o controle</text><text x='668' y='146' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.8'>COM E SEM O MODELO</text><text x='668' y='188' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Ônibus qualquer chega colado</text><text x='668' y='272' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Ônibus com alerta chega colado</text><rect x='668' y='200' width='372' height='32' rx='6' fill='#2A3456' fill-opacity='.5'/><rect x='668' y='284' width='372' height='32' rx='6' fill='#2A3456' fill-opacity='.5'/><text x='44' y='94' font-size='16' font-weight='600' fill='#42D392' text-anchor='start' letter-spacing='1.2'>"
			    & ( [Janela do teste] )
			    & "</text><text x='34' y='238' font-size='150' font-weight='700' fill='#42D392'>"
			    & ( FORMAT ( ac, "0%" ) )
			    & "</text><rect x='668' y='200' width='"
			    & ( FORMAT ( ch * 372, "0.0", "en-US" ) )
			    & "' height='32' rx='6' fill='#9AA3C2'/><text x='1040' y='188' font-size='19' font-weight='700' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( ch, "0.0%" ) )
			    & "</text><rect x='668' y='284' width='"
			    & ( FORMAT ( ac * 372, "0.0", "en-US" ) )
			    & "' height='32' rx='6' fill='#42D392'/><text x='1040' y='272' font-size='19' font-weight='700' fill='#42D392' text-anchor='end'>"
			    & ( FORMAT ( ac, "0.0%" ) )
			    & "</text><text x='668' y='372' font-size='34' font-weight='700' fill='#42D392'>"
			    & ( FORMAT ( [Vezes a chance], "0.0" ) )
			    & "×<tspan font-size='19' font-weight='400' fill='#C9D0E4' font-family='Segoe UI, sans-serif' dx='10'>a chance de um ônibus qualquer</tspan></text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 595d7ded-5971-5acd-a37d-9d0b13b1e5ee

	/// Alertas, acertos, colados avisados e passagens.
	measure 'HTML previsão números' =
			IF ( ISBLANK ( [Alertas] ), "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 584 308' width='100%' height='100%'><text x='292' y='154' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 324' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<rect x='0' y='0' width='284' height='146' rx='16' fill='#182038' stroke='#2A3456'/><rect x='0' y='18' width='4' height='110' rx='2' fill='#F4F6FB'/><text x='22' y='34' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>ALERTAS</text><text x='20' y='92' font-size='52' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [Alertas], "#,0" ) )
			    & "</text><text x='22' y='130' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>passagens apontadas pelo modelo</text><rect x='300' y='0' width='284' height='146' rx='16' fill='#182038' stroke='#2A3456'/><rect x='300' y='18' width='4' height='110' rx='2' fill='#42D392'/><text x='322' y='34' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>ACERTOS</text><text x='320' y='92' font-size='52' font-weight='700' fill='#42D392'>"
			    & ( FORMAT ( [Acertos], "#,0" ) )
			    & "</text><text x='322' y='130' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>chegaram colados de fato</text><rect x='0' y='162' width='284' height='146' rx='16' fill='#182038' stroke='#2A3456'/><rect x='0' y='180' width='4' height='110' rx='2' fill='#F4F6FB'/><text x='22' y='196' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>COLADOS AVISADOS</text><text x='20' y='254' font-size='52' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [Colados avisados], "0%" ) )
			    & "</text><text x='22' y='292' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>dos colados tiveram alerta</text><rect x='300' y='162' width='284' height='146' rx='16' fill='#182038' stroke='#2A3456'/><rect x='300' y='180' width='4' height='110' rx='2' fill='#F4F6FB'/><text x='322' y='196' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>PASSAGENS NO TESTE</text><text x='320' y='254' font-size='52' font-weight='700' fill='#F4F6FB'>"
			    & ( VAR v = [Exemplos] RETURN IF ( v >= 1000000, FORMAT ( v / 1000000, "0.0" ) & " mi", IF ( v >= 1000, FORMAT ( v / 1000, "0" ) & " mil", FORMAT ( v, "0" ) ) ) )
			    & "</text><text x='322' y='292' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>ônibus avaliados pelo modelo</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: ddde95b8-215e-5994-b4b8-a41ccf69d0ce

	/// Alertas e acertos por dia do teste.
	measure 'HTML previsão dia' =
			VAR t = FILTER ( CALCULATETABLE ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@a", [Alertas no dia],
			        "@c", [Acertos no dia], "@p", [Acerto no dia] ), REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) ),
			        [@a] > 0 )
			VAR d0 = MINX ( t, dim_data[data] )
			VAR n = INT ( MAXX ( t, dim_data[data] ) - d0 ) + 1
			VAR bw = 974 / n
			VAR mx = MAXX ( t, [@a] )
			VAR passo = IF ( mx > 8000, 4000, IF ( mx > 4000, 2000, IF ( mx > 2000, 1000, IF ( mx > 800, 500, 100 ) ) ) )
			VAR topo = CEILING ( mx * 1.18 / passo, 1 ) * passo
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1048 334' width='100%' height='100%'><text x='524' y='167' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1064 350' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<rect x='0' y='6' width='15' height='15' rx='3' fill='#F4F6FB' fill-opacity='.2' stroke='#F4F6FB' stroke-opacity='.5'/><text x='23' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>alertas do dia</text><rect x='158' y='6' width='15' height='15' rx='3' fill='#42D392'/><text x='181' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>chegaram colados</text><text x='331' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>o número acima da barra é o acerto do dia</text>"
			    & ( CONCATENATEX ( GENERATESERIES ( 1, ROUND ( topo / passo, 0 ), 1 ), VAR v = [Value] * passo VAR yg = 276 - v / topo * 212 RETURN "<line x1='64' x2='1038' y1='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' stroke='#2A3456' stroke-dasharray='4 6'/><text x='54' y='"
			    & ( FORMAT ( yg + 5, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( v, "#,0" ) )
			    & "</text>", "" ) )
			    & "<line x1='64' x2='1038' y1='276' y2='276' stroke='#9AA3C2'/>"
			    & ( CONCATENATEX ( t, VAR x = 64 + INT ( dim_data[data] - d0 ) * bw + bw * 0.18 VAR ha = [@a] / topo * 212 VAR hc = [@c] / topo * 212 RETURN "<rect x='"
			    & ( FORMAT ( x, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 276 - ha, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( bw * 0.64, "0.0", "en-US" ) )
			    & "' height='"
			    & ( FORMAT ( ha, "0.0", "en-US" ) )
			    & "' rx='3' fill='#F4F6FB' fill-opacity='.2' stroke='#F4F6FB' stroke-opacity='.4'/><rect x='"
			    & ( FORMAT ( x, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 276 - hc, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( bw * 0.64, "0.0", "en-US" ) )
			    & "' height='"
			    & ( FORMAT ( hc, "0.0", "en-US" ) )
			    & "' rx='3' fill='#42D392'/><text x='"
			    & ( FORMAT ( x + bw * 0.32, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 276 - ha - 10, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#42D392' text-anchor='middle'>"
			    & ( FORMAT ( [@p], "0%" ) )
			    & "</text><text x='"
			    & ( FORMAT ( x + bw * 0.32, "0.0", "en-US" ) )
			    & "' y='302' font-size='16' fill='#C9D0E4' text-anchor='middle'>"
			    & ( FORMAT ( dim_data[data], "dd/mm" ) )
			    & "</text><text x='"
			    & ( FORMAT ( x + bw * 0.32, "0.0", "en-US" ) )
			    & "' y='322' font-size='13' fill='#9AA3C2' text-anchor='middle'>"
			    & ( FORMAT ( dim_data[data], "ddd" ) )
			    & "</text>", "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: a00977fb-abc5-5bd6-8393-cb8c5a05dd7a

	/// Linhas com mais alertas no teste.
	measure 'HTML previsão linhas' =
			VAR t = TOPN ( 6, FILTER ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@a", [Alertas], "@c", [Acertos],
			        "@p", [Acerto dos alertas], "@nome", CALCULATE ( MAX ( dim_linha[route_long_name] ) ) ), [@a] > 0 ),
			        [@a], DESC, dim_linha[route_id], ASC )
			VAR r = ADDCOLUMNS ( t, "@k", VAR _v = [@a] VAR _c = dim_linha[route_id] RETURN COUNTROWS ( FILTER ( t, [@a] > _v || ( [@a] = _v && dim_linha[route_id] < _c ) ) ) + 1 )
			VAR topo = MAXX ( t, [@a] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 584 334' width='100%' height='100%'><text x='292' y='167' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 350' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='14' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.3'>LINHA</text><text x='584' y='14' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.3'>ALERTAS · ACERTO</text>"
			    & ( CONCATENATEX ( r, VAR y = 30 + ( [@k] - 1 ) * 50.67 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 20, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#F4F6FB'>"
			    & ( dim_linha[route_id] )
			    & "</text><text x='76' y='"
			    & ( FORMAT ( y + 20, "0.0", "en-US" ) )
			    & "' font-size='14' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( LEN ( [@nome] ) > 40, LEFT ( [@nome], 39 ) & "…", [@nome] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><rect x='0' y='"
			    & ( FORMAT ( y + 30, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@a] / topo * 424, "0.0", "en-US" ) )
			    & "' height='12' rx='3' fill='#F4F6FB' fill-opacity='.2' stroke='#F4F6FB' stroke-opacity='.4'/><rect x='0' y='"
			    & ( FORMAT ( y + 30, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@c] / topo * 424, "0.0", "en-US" ) )
			    & "' height='12' rx='3' fill='#42D392'/><text x='584' y='"
			    & ( FORMAT ( y + 20, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#F4F6FB' text-anchor='end'>"
			    & ( FORMAT ( [@a], "#,0" ) )
			    & "</text><text x='584' y='"
			    & ( FORMAT ( y + 41, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#42D392' text-anchor='end'>"
			    & ( FORMAT ( [@p], "0%" ) )
			    & " acerto</text>", "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: f6295de8-b78c-5b76-a8ec-17d04c71991c

	/// Cobertura, vies de interpolacao e feed parado.
	measure 'HTML confiança' =
			VAR cob = [Cobertura]
			VAR tq = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@c", [Cobertura] ), NOT ISBLANK ( [@c] ) )
			VAR pior = TOPN ( 1, tq, [@c], ASC, dim_data[data], ASC )
			VAR cp = MINX ( pior, [@c] )
			VAR dp = MAXX ( pior, dim_data[data] )
			VAR vp = [Viés de interpolação %]
			RETURN
			    IF ( ISBLANK ( cob ), "<div style='width:100%;height:100%;box-sizing:border-box;border-radius:24px;border:1px solid color-mix(in srgb, #6AA8FF 16%, rgba(148,163,255,.10));background:linear-gradient(180deg, color-mix(in srgb, #6AA8FF 8%, #111729), #111729 110px);box-shadow:inset 0 1px 0 color-mix(in srgb, #6AA8FF 30%, transparent)'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1752 330' width='100%' height='100%'><text x='876' y='165' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;box-sizing:border-box;border-radius:24px;border:1px solid color-mix(in srgb, #6AA8FF 16%, rgba(148,163,255,.10));background:linear-gradient(180deg, color-mix(in srgb, #6AA8FF 8%, #111729), #111729 110px);box-shadow:inset 0 1px 0 color-mix(in srgb, #6AA8FF 30%, transparent)'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1768 346' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<rect x='24' y='24' width='552' height='282' rx='18' fill='#182038' stroke='#2A3456'/><text x='52' y='72' font-size='23' font-weight='700' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Os ônibus aparecem no dado?</text><text x='50' y='156' font-size='72' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( cob, "0.0%" ) )
			    & "</text><text x='52' y='196' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>das passagens viram um intervalo válido</text><text x='52' y='223' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( "pior dia: " & FORMAT ( dp, "dd/mm" ) & ", com " & FORMAT ( cp, "0.0%" ) )
			    & "</text><rect x='52' y='244' width='496' height='40' rx='20' fill-opacity='.14' fill='"
			    & ( IF ( cob >= 0.9, "#42D392", "#FFB347" ) )
			    & "' stroke='"
			    & ( IF ( cob >= 0.9, "#42D392", "#FFB347" ) )
			    & "'/><text x='74' y='270' font-size='17' font-weight='600' font-family='Segoe UI, sans-serif' fill='"
			    & ( IF ( cob >= 0.9, "#42D392", "#FFB347" ) )
			    & "'>"
			    & ( IF ( cob >= 0.9, "✓ Sim: mais de 9 em cada 10", "⚠ Abaixo de 90%: leia com cuidado" ) )
			    & "</text><rect x='600' y='24' width='552' height='282' rx='18' fill='#182038' stroke='#2A3456'/><text x='628' y='72' font-size='23' font-weight='700' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>A hora estimada distorce a conta?</text><text x='626' y='156' font-size='72' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [Viés de interpolação] * 60, "0.0" ) & " s" )
			    & "</text><text x='628' y='196' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>a mais na espera extra, por erro de interpolação</text><text x='628' y='223' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( "é " & FORMAT ( vp, "0.00%" ) & " da espera extra" )
			    & "</text><rect x='628' y='244' width='496' height='40' rx='20' fill-opacity='.14' fill='"
			    & ( IF ( vp < 0.01, "#42D392", "#FFB347" ) )
			    & "' stroke='"
			    & ( IF ( vp < 0.01, "#42D392", "#FFB347" ) )
			    & "'/><text x='650' y='270' font-size='17' font-weight='600' font-family='Segoe UI, sans-serif' fill='"
			    & ( IF ( vp < 0.01, "#42D392", "#FFB347" ) )
			    & "'>"
			    & ( IF ( vp < 0.01, "✓ Não: menos de 1% da espera extra", "⚠ Mais de 1% da espera extra" ) )
			    & "</text><rect x='1176' y='24' width='552' height='282' rx='18' fill='#182038' stroke='#2A3456'/><text x='1204' y='72' font-size='23' font-weight='700' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>E quando o feed da PBH para?</text><text x='1202' y='156' font-size='72' font-weight='700' fill='#FF6B6B'>"
			    & ( VAR v = [Feed parado] RETURN IF ( v >= 1000000, FORMAT ( v / 1000000, "0.0" ) & " mi", IF ( v >= 1000, FORMAT ( v / 1000, "0" ) & " mil", FORMAT ( v, "0" ) ) ) )
			    & "</text><text x='1204' y='196' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>intervalos descartados, não estimados</text><text x='1204' y='223' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( FORMAT ( [Feed parado %], "0.0%" ) & " dos intervalos · " & IF ( [Dias com feed parado] = 0, "nenhuma queda nos " & FORMAT ( [Dias com qualidade], "0" ) & " dias", "queda em " & FORMAT ( [Dias com feed parado], "0" ) & " de " & FORMAT ( [Dias com qualidade], "0" ) & " dias" ) )
			    & "</text><rect x='1204' y='244' width='496' height='40' rx='20' fill-opacity='.14' fill='"
			    & ( "#42D392" )
			    & "' stroke='"
			    & ( "#42D392" )
			    & "'/><text x='1226' y='270' font-size='17' font-weight='600' font-family='Segoe UI, sans-serif' fill='"
			    & ( "#42D392" )
			    & "'>"
			    & ( "✓ Ficam fora da conta da espera" )
			    & "</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 69939a54-c3cc-5f97-84c1-942a48ca295b

	/// Cobertura e feed parado por dia.
	measure 'HTML confiança dia' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@c", [Cobertura], "@f", [Feed parado] ),
			        NOT ISBLANK ( [@c] ) )
			VAR d0 = MINX ( t, dim_data[data] )
			VAR n = INT ( MAXX ( t, dim_data[data] ) - d0 ) + 1
			VAR bw = 1612 / n
			VAR cob = [Cobertura]
			VAR ym = 214 - ( MAX ( 0.8, MIN ( 1, cob ) ) - 0.8 ) / 0.2 * 170
			VAR fmax = MAXX ( t, [@f] )
			VAR ftopo = IF ( fmax <= 0, 1000, CEILING ( fmax * 1.1 / 10000, 1 ) * 10000 )
			VAR pior = TOPN ( 1, t, [@c], ASC, dim_data[data], ASC )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1700 424' width='100%' height='100%'><text x='850' y='212' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1716 440' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='18' font-size='14' font-weight='700' fill='#6AA8FF' text-anchor='start' letter-spacing='1.5'>COBERTURA POR DIA</text><text x='200' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>intervalos válidos por passagem · eixo de 80% a 100%</text><line x1='72' x2='1684' y1='214.0' y2='214.0' stroke='#2A3456' stroke-dasharray='4 6'/><text x='62' y='219' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>80%</text><line x1='72' x2='1684' y1='171.5' y2='171.5' stroke='#2A3456' stroke-dasharray='4 6'/><text x='62' y='177' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>85%</text><line x1='72' x2='1684' y1='129.0' y2='129.0' stroke='#2A3456' stroke-dasharray='4 6'/><text x='62' y='134' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>90%</text><line x1='72' x2='1684' y1='86.5' y2='86.5' stroke='#2A3456' stroke-dasharray='4 6'/><text x='62' y='92' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>95%</text><line x1='72' x2='1684' y1='44.0' y2='44.0' stroke='#2A3456' stroke-dasharray='4 6'/><text x='62' y='49' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>100%</text><text x='0' y='262' font-size='14' font-weight='700' fill='#FF6B6B' text-anchor='start' letter-spacing='1.5'>INTERVALOS DESCARTADOS COM O FEED PARADO</text><text x='440' y='262' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>ficam fora da conta da espera</text><line x1='72' x2='1684' y1='372' y2='372' stroke='#9AA3C2'/><text x='62' y='377' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>0</text><line x1='72' x2='1684' y1='284' y2='284' stroke='#2A3456' stroke-dasharray='4 6'/><line x1='72' x2='1684' y1='"
			    & ( FORMAT ( ym, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( ym, "0.0", "en-US" ) )
			    & "' stroke='#6AA8FF' stroke-opacity='.6' stroke-width='2' stroke-dasharray='8 6'/><text x='1684' y='38' font-size='15' font-weight='600' fill='#6AA8FF' text-anchor='end'>média do período: "
			    & ( FORMAT ( cob, "0.0%" ) )
			    & "</text><polyline points='"
			    & ( CONCATENATEX ( t, FORMAT ( 72 + INT ( dim_data[data] - d0 ) * bw + bw / 2, "0.0", "en-US" ) & "," & FORMAT ( 214 - ( MAX ( 0.8, MIN ( 1, [@c] ) ) - 0.8 ) / 0.2 * 170, "0.0", "en-US" ), " ", dim_data[data], ASC ) )
			    & "' fill='none' stroke='#6AA8FF' stroke-width='2.5' stroke-linejoin='round'/>"
			    & ( CONCATENATEX ( t, "<circle cx='"
			    & ( FORMAT ( 72 + INT ( dim_data[data] - d0 ) * bw + bw / 2, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( 214 - ( MAX ( 0.8, MIN ( 1, [@c] ) ) - 0.8 ) / 0.2 * 170, "0.0", "en-US" ) )
			    & "' r='3.5' fill='#6AA8FF'/>", "" ) )
			    & ( CONCATENATEX ( pior, "<circle cx='"
			    & ( FORMAT ( 72 + INT ( dim_data[data] - d0 ) * bw + bw / 2, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( 214 - ( MAX ( 0.8, MIN ( 1, [@c] ) ) - 0.8 ) / 0.2 * 170, "0.0", "en-US" ) )
			    & "' r='7' fill='none' stroke='#FF6B6B' stroke-width='2.5'/><text x='"
			    & ( FORMAT ( 72 + INT ( dim_data[data] - d0 ) * bw + bw / 2 + IF ( INT ( dim_data[data] - d0 ) * bw > 1290, -14, 14 ), "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 214 - ( MAX ( 0.8, MIN ( 1, [@c] ) ) - 0.8 ) / 0.2 * 170 + 5, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#F4F6FB' text-anchor='"
			    & ( IF ( INT ( dim_data[data] - d0 ) * bw > 1290, "end", "start" ) )
			    & "'>pior dia: "
			    & ( FORMAT ( [@c], "0.0%" ) )
			    & " em "
			    & ( FORMAT ( dim_data[data], "dd/mm" ) )
			    & "</text>", "" ) )
			    & "<text x='62' y='289' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>"
			    & ( VAR v = ftopo RETURN IF ( v >= 1000000, FORMAT ( v / 1000000, "0.0" ) & " mi", IF ( v >= 1000, FORMAT ( v / 1000, "0" ) & " mil", FORMAT ( v, "0" ) ) ) )
			    & "</text>"
			    & ( CONCATENATEX ( t, VAR hf = [@f] / ftopo * 88 RETURN "<rect x='"
			    & ( FORMAT ( 72 + INT ( dim_data[data] - d0 ) * bw + bw * 0.15, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 372 - hf, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( bw * 0.7, "0.0", "en-US" ) )
			    & "' height='"
			    & ( FORMAT ( hf, "0.0", "en-US" ) )
			    & "' rx='2' fill='#FF6B6B'/>", "" ) )
			    & ( CONCATENATEX ( FILTER ( t, n <= 10 || WEEKDAY ( dim_data[data], 2 ) = 1 ),
			        VAR xd = 72 + INT ( dim_data[data] - d0 ) * bw + bw / 2
			        RETURN "<text x='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' y='402' font-size='16' fill='#C9D0E4' text-anchor='middle'>"
			    & ( FORMAT ( dim_data[data], "dd/mm" ) )
			    & "</text><line x1='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' y1='374' y2='381' stroke='#9AA3C2'/>", "" ) )
			    & "<text x='72' y='422' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( IF ( n <= 10, "dias do período", "datas: as segundas-feiras" ) )
			    & "</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 7ffe21d8-ed78-58e0-b3ee-7ec642a5a08b

	/// Espera extra hoje, simulada e o ganho.
	measure 'HTML simulador' =
			VAR ee = [Espera extra]
			VAR es = [Espera extra simulada]
			VAR g = [Ganho por passageiro]
			VAR ws = DIVIDE ( es, ee ) * 508
			RETURN
			    IF ( ISBLANK ( ee ), "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 508 694' width='100%' height='100%'><text x='254' y='347' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 524 710' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='24' font-size='16' font-weight='700' fill='#42D392' text-anchor='start' letter-spacing='1.5'>ESPAÇANDO "
			    & ( FORMAT ( [Espaçamento], "0%" ) )
			    & " DOS PARES COLADOS</text><text x='0' y='84' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>ESPERA EXTRA HOJE</text><text x='-2' y='146' font-size='60' font-weight='700' fill='#FFB347'>+"
			    & ( FORMAT ( ee, "0.00" ) )
			    & "<tspan font-size='26' dx='8'>min</tspan></text><rect x='0' y='164' width='508' height='18' rx='5' fill='#FFB347'/><text x='0' y='236' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>COM O ESPAÇAMENTO</text><text x='-2' y='298' font-size='60' font-weight='700' fill='#42D392'>+"
			    & ( FORMAT ( es, "0.00" ) )
			    & "<tspan font-size='26' dx='8'>min</tspan></text><rect x='0' y='316' width='"
			    & ( FORMAT ( ws, "0.0", "en-US" ) )
			    & "' height='18' rx='5' fill='#42D392'/>"
			    & ( IF ( 508 - ws > 2, "<rect x='"
			    & ( FORMAT ( ws + 1, "0.0", "en-US" ) )
			    & "' y='317' width='"
			    & ( FORMAT ( 508 - ws - 2, "0.0", "en-US" ) )
			    & "' height='16' rx='5' fill='none' stroke='#FFB347' stroke-dasharray='5 4'/>" ) )
			    & "<text x='0' y='388' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.6'>GANHO POR IDA AO PONTO</text><text x='-2' y='456' font-size='64' font-weight='700' fill='#42D392'>"
			    & ( IF ( g > 0, "−" ) )
			    & ( FORMAT ( g, "0.00" ) )
			    & "<tspan font-size='28' dx='8'>min</tspan></text><text x='0' y='494' font-size='19' font-weight='400' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>cerca de "
			    & ( FORMAT ( g * 60, "0" ) )
			    & " segundos a menos de espera</text><text x='0' y='522' font-size='19' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( FORMAT ( [Ganho % da espera], "0.0%" ) )
			    & " da espera média no ponto</text><line x1='0' x2='508' y1='560' y2='560' stroke='#2A3456'/><text x='0' y='600' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>Como a conta funciona: tira da espera extra a parte que some</text><text x='0' y='622' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>quando o ônibus atrasado, que puxou o de trás, passa no meio</text><text x='0' y='644' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>do caminho entre os dois (o corte sem colagem). Não inclui o</text><text x='0' y='666' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>3º ônibus em diante de um comboio.</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 00e2da88-bad2-580f-9746-669ffea7f1fc

	/// Espera extra hoje e simulada por faixa.
	measure 'HTML simulador faixa' =
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_faixa[faixa], dim_faixa[horas], dim_faixa[ordem] ),
			        "@h", [Espera extra], "@s", [Espera extra simulada] ), NOT ISBLANK ( [@h] ) )
			VAR topo = MAXX ( t, [@h] ) * 1.05
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1124 328' width='100%' height='100%'><text x='562' y='164' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1140 344' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<rect x='0' y='6' width='15' height='15' rx='3' fill='#FFB347'/><text x='23' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>espera extra hoje (min)</text><rect x='225' y='6' width='15' height='15' rx='3' fill='#42D392'/><text x='248' y='18' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>com o espaçamento escolhido</text><line x1='0' x2='1124' y1='270' y2='270' stroke='#9AA3C2'/>"
			    & ( CONCATENATEX ( t, VAR gx = ( dim_faixa[ordem] - 0.5 ) * 187.33 VAR h1 = [@h] / topo * 218 VAR h2 = [@s] / topo * 218 RETURN "<rect x='"
			    & ( FORMAT ( gx - 64, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 270 - h1, "0.0", "en-US" ) )
			    & "' width='60' height='"
			    & ( FORMAT ( h1, "0.0", "en-US" ) )
			    & "' rx='4' fill='#FFB347'/><rect x='"
			    & ( FORMAT ( gx + 4, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 270 - h2, "0.0", "en-US" ) )
			    & "' width='60' height='"
			    & ( FORMAT ( h2, "0.0", "en-US" ) )
			    & "' rx='4' fill='#42D392'/><text x='"
			    & ( FORMAT ( gx - 34, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 270 - h1 - 9, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#FFB347' text-anchor='middle'>"
			    & ( FORMAT ( [@h], "0.00" ) )
			    & "</text><text x='"
			    & ( FORMAT ( gx + 34, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 270 - h2 - 9, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#42D392' text-anchor='middle'>"
			    & ( FORMAT ( [@s], "0.00" ) )
			    & "</text><text x='"
			    & ( FORMAT ( gx, "0.0", "en-US" ) )
			    & "' y='296' font-size='17' fill='#F4F6FB' text-anchor='middle' font-family='Segoe UI, sans-serif'>"
			    & ( dim_faixa[faixa] )
			    & "</text><text x='"
			    & ( FORMAT ( gx, "0.0", "en-US" ) )
			    & "' y='318' font-size='14' fill='#C9D0E4' text-anchor='middle'>"
			    & ( dim_faixa[horas] )
			    & "</text>", "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 1f708dfc-a346-5b40-8d73-c28e0cad6c2b

	/// Linhas com maior parte do ganho.
	measure 'HTML simulador linhas' =
			VAR t = TOPN ( 6, FILTER ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@p", [Parte do ganho],
			        "@h", [Espera extra], "@s", [Espera extra simulada], "@g", [Ganho por passageiro],
			        "@nome", CALCULATE ( MAX ( dim_linha[route_long_name] ) ) ), [@p] > 0 ),
			        [@p], DESC, dim_linha[route_id], ASC )
			VAR r = ADDCOLUMNS ( t, "@k", VAR _v = [@p] VAR _c = dim_linha[route_id] RETURN COUNTROWS ( FILTER ( t, [@p] > _v || ( [@p] = _v && dim_linha[route_id] < _c ) ) ) + 1 )
			VAR topo = MAXX ( t, [@g] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1124 314' width='100%' height='100%'><text x='562' y='157' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Com 0% de espaçamento não há ganho: escolha outro valor</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1140 330' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='14' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>LINHA</text><text x='540' y='14' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>HOJE</text><text x='650' y='14' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>SIMULADA</text><text x='690' y='14' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>GANHO POR PASSAGEIRO (MIN)</text><text x='1124' y='14' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>% DO GANHO DA REDE</text>"
			    & ( CONCATENATEX ( r, VAR y = 30 + ( [@k] - 1 ) * 47.33 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 29.7, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='700' fill='#F4F6FB'>"
			    & ( dim_linha[route_id] )
			    & "</text><text x='80' y='"
			    & ( FORMAT ( y + 29.7, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( LEN ( [@nome] ) > 42, LEFT ( [@nome], 41 ) & "…", [@nome] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='540' y='"
			    & ( FORMAT ( y + 29.7, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#FFB347' text-anchor='end'>"
			    & ( FORMAT ( [@h], "0.00" ) )
			    & "</text><text x='650' y='"
			    & ( FORMAT ( y + 29.7, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#42D392' text-anchor='end'>"
			    & ( FORMAT ( [@s], "0.00" ) )
			    & "</text><rect x='690' y='"
			    & ( FORMAT ( y + 15.7, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@g] / topo * 230, "0.0", "en-US" ) )
			    & "' height='16' rx='4' fill='#42D392'/><text x='"
			    & ( FORMAT ( 698 + [@g] / topo * 230, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 29.7, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#42D392'>−"
			    & ( FORMAT ( [@g], "0.00" ) )
			    & "</text><text x='1124' y='"
			    & ( FORMAT ( y + 29.7, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='700' fill='#F4F6FB' text-anchor='end'>"
			    & ( FORMAT ( [@p], "0.0%" ) )
			    & "</text><line x1='0' x2='1124' y1='"
			    & ( FORMAT ( y + 47.3, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( y + 47.3, "0.0", "en-US" ) )
			    & "' stroke='#2A3456' stroke-opacity='.6'/>", "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: f45cd113-c92c-5ea7-8d9b-495cac4ca0a7

	/// Espera regular e extra por faixa, da linha escolhida.
	measure 'HTML ficha faixa' =
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_faixa[faixa], dim_faixa[horas], dim_faixa[ordem] ),
			        "@r", [Espera regular], "@x", [Espera extra] ), NOT ISBLANK ( [@x] ) )
			VAR topo = MAXX ( t, [@r] + [@x] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 808 270' width='100%' height='100%'><text x='404' y='135' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 824 286' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( t,
			        VAR y = ( dim_faixa[ordem] - 1 ) * 45
			        VAR wr = DIVIDE ( [@r], topo ) * 492
			        VAR wx = DIVIDE ( [@x], topo ) * 492
			        RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 22, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( dim_faixa[faixa] )
			    & "</text><text x='0' y='"
			    & ( FORMAT ( y + 43, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( dim_faixa[horas] )
			    & "</text><rect x='170' y='"
			    & ( FORMAT ( y + 12, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( wr, "0.0", "en-US" ) )
			    & "' height='26' rx='4' fill='#6AA8FF'/><rect x='"
			    & ( FORMAT ( 170 + wr, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 12, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( wx, "0.0", "en-US" ) )
			    & "' height='26' rx='4' fill='#FFB347'/><text x='808' y='"
			    & ( FORMAT ( y + 24, "0.0", "en-US" ) )
			    & "' font-size='21' font-weight='700' fill='#FFB347' text-anchor='end'>+"
			    & ( FORMAT ( [@x], "0.00" ) )
			    & "</text><text x='808' y='"
			    & ( FORMAT ( y + 44, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' text-anchor='end' font-family='Segoe UI, sans-serif'>de "
			    & ( FORMAT ( [@r] + [@x], "0.0" ) )
			    & " min</text>", "", dim_faixa[ordem], ASC ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 8dad7081-b73d-5cdf-9a82-d75254d4a5b5

	/// Espera extra por dia da linha escolhida, com eventos.
	measure 'HTML ficha dia' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@v", [Espera extra],
			        "@e", CALCULATE ( MAX ( dim_data[evento] ) ) ), NOT ISBLANK ( [@v] ) )
			VAR d0 = MINX ( t, dim_data[data] )
			VAR d1 = MAXX ( t, dim_data[data] )
			VAR n = INT ( d1 - d0 ) + 1
			VAR med = [Espera extra]
			VAR topo = MAX ( 2, CEILING ( MAXX ( t, [@v] ) * 1.3, 1 ) )
			VAR passo = IF ( topo <= 5, 1, 2 )
			VAR bw = 350 / n
			VAR ym = 208 - med / topo * 178
			VAR evd = FILTER ( eventos, eventos[evento] <> "" && eventos[data] >= d0 && eventos[data] <= d1 )
			VAR ev = ADDCOLUMNS ( SUMMARIZE ( evd, eventos[evento], eventos[evento_l1], eventos[evento_l2],
			        eventos[evento_l3], eventos[evento_n] ),
			        "@d", VAR e = eventos[evento] RETURN MINX ( FILTER ( evd, eventos[evento] = e ), eventos[data] ) )
			VAR ev2 = ADDCOLUMNS ( ev, "@i", RANKX ( ev, [@d], , ASC, DENSE ) )
			VAR ev3 = ADDCOLUMNS ( ev2, "@y", VAR dd = [@d]
			        RETURN 51 + SUMX ( FILTER ( ev2, [@d] < dd ), eventos[evento_n] * 19 + 12 ) )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 824 270' width='100%' height='100%'><text x='412' y='135' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 840 286' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( GENERATESERIES ( passo, topo, passo ),
			        VAR yg = 208 - [Value] / topo * 178
			        RETURN "<line x1='50' x2='400' y1='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' stroke='#2A3456' stroke-dasharray='4 6'/><text x='40' y='"
			    & ( FORMAT ( yg + 5, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( [Value], "0" ) )
			    & "</text>", "" ) )
			    & "<line x1='50' x2='400' y1='208' y2='208' stroke='#9AA3C2'/><text x='40' y='213' font-size='15' fill='#9AA3C2' text-anchor='end'>0</text>"
			    & ( CONCATENATEX ( t,
			        VAR i = INT ( dim_data[data] - d0 )
			        VAR x = 50 + i * bw + bw * 0.14
			        VAR hb = DIVIDE ( [@v], topo ) * 178
			        VAR e = [@e]
			        VAR tem = e <> ""
			        VAR k = MAXX ( FILTER ( ev2, eventos[evento] = e ), [@i] )
			        VAR primeiro = tem && dim_data[data] = MAXX ( FILTER ( ev2, eventos[evento] = e ), [@d] )
			        VAR cy = IF ( MOD ( k, 2 ) = 1, 44, 74 )
			        RETURN "<rect x='"
			    & ( FORMAT ( x, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 208 - hb, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( bw * 0.72, "0.0", "en-US" ) )
			    & "' height='"
			    & ( FORMAT ( hb, "0.0", "en-US" ) )
			    & "' rx='2' fill='"
			    & ( IF ( tem, "#F4F6FB", "#FFB347" ) )
			    & "'/>"
			    & ( IF ( primeiro, "<line x1='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' y1='"
			    & ( FORMAT ( 208 - hb - 3, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( cy + 12, "0.0", "en-US" ) )
			    & "' stroke='#F4F6FB' stroke-opacity='.45' stroke-dasharray='2 3'/><circle cx='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( cy, "0.0", "en-US" ) )
			    & "' r='12' fill='#F4F6FB'/><text x='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( cy + 5, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#0A0E1C' text-anchor='middle'>"
			    & ( FORMAT ( k, "0" ) )
			    & "</text>" ) ), "", dim_data[data], ASC ) )
			    & "<line x1='50' x2='400' y1='"
			    & ( FORMAT ( ym, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( ym, "0.0", "en-US" ) )
			    & "' stroke='#6AA8FF' stroke-width='2' stroke-dasharray='8 6'/><line x1='50' x2='80' y1='10' y2='10' stroke='#6AA8FF' stroke-width='2' stroke-dasharray='8 6'/><text x='90' y='16' font-size='16' font-weight='600' fill='#6AA8FF'>média do período: "
			    & ( FORMAT ( med, "0.00" ) )
			    & " min</text>"
			    & ( CONCATENATEX ( FILTER ( t, n <= 10 || WEEKDAY ( dim_data[data], 2 ) = 1 ),
			        VAR xd = 50 + INT ( dim_data[data] - d0 ) * bw + bw / 2
			        RETURN "<text x='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' y='236' font-size='16' fill='#C9D0E4' text-anchor='middle'>"
			    & ( FORMAT ( dim_data[data], "dd/mm" ) )
			    & "</text><line x1='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' y1='208' y2='215' stroke='#9AA3C2'/>", "" ) )
			    & "<text x='50' y='266' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( IF ( n <= 10, "dias do período", "datas: as segundas-feiras" ) )
			    & "</text><text x='436' y='20' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>EVENTOS NA CIDADE</text>"
			    & ( IF ( COUNTROWS ( ev2 ) = 0,
			        "<text x='436' y='60' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Nenhum evento anotado no período</text>",
			        CONCATENATEX ( FILTER ( ev3, [@y] + ( eventos[evento_n] - 1 ) * 19 <= 264 ),
			            VAR y = [@y]
			            RETURN "<circle cx='449' cy='"
			    & ( FORMAT ( y - 6, "0.0", "en-US" ) )
			    & "' r='13' fill='#F4F6FB'/><text x='449' y='"
			    & ( FORMAT ( y - 1, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#0A0E1C' text-anchor='middle'>"
			    & ( FORMAT ( [@i], "0" ) )
			    & "</text><text x='472' y='"
			    & ( FORMAT ( y, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [@d], "dd/mm" ) )
			    & "</text><text x='524' y='"
			    & ( FORMAT ( y, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( eventos[evento_l1], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='524' y='"
			    & ( FORMAT ( y + 19, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( eventos[evento_l2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='524' y='"
			    & ( FORMAT ( y + 38, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( eventos[evento_l3], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text>", "", [@d], ASC ) ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: bddcbdda-6a4e-5c79-a48d-6813b0634cbd

	/// Intervalo e colados contra espera extra por linha, com a correlacao.
	measure 'HTML o que pesa linhas' =
			VAR t0 = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@r", [Espera regular],
			        "@c", [Colados], "@e", [Espera extra], "@h", [Horas de serviço] ),
			    REMOVEFILTERS ( dim_frequencia ), dim_frequencia[frequencia] = "alta" )
			VAR htot = SUMX ( t0, [@h] )
			VAR t = FILTER ( t0, NOT ISBLANK ( [@e] ) && DIVIDE ( [@h], htot ) >= 0.001 )
			VAR n = COUNTROWS ( t )
			VAR r_int_x = SUMX ( t, [@r] ) VAR r_int_y = SUMX ( t, [@e] )
			VAR r_int_xy = SUMX ( t, [@r] * [@e] ) VAR r_int_xx = SUMX ( t, [@r] ^ 2 ) VAR r_int_yy = SUMX ( t, [@e] ^ 2 )
			VAR r_int = DIVIDE ( n * r_int_xy - r_int_x * r_int_y,
			    SQRT ( ( n * r_int_xx - r_int_x ^ 2 ) * ( n * r_int_yy - r_int_y ^ 2 ) ) )
			VAR r_col_x = SUMX ( t, [@c] ) VAR r_col_y = SUMX ( t, [@e] )
			VAR r_col_xy = SUMX ( t, [@c] * [@e] ) VAR r_col_xx = SUMX ( t, [@c] ^ 2 ) VAR r_col_yy = SUMX ( t, [@e] ^ 2 )
			VAR r_col = DIVIDE ( n * r_col_xy - r_col_x * r_col_y,
			    SQRT ( ( n * r_col_xx - r_col_x ^ 2 ) * ( n * r_col_yy - r_col_y ^ 2 ) ) )
			VAR mr = PERCENTILEX.INC ( t, [@r], 0.98 ) * 1.1
			VAR mc = PERCENTILEX.INC ( t, [@c], 0.98 ) * 1.1
			VAR my = PERCENTILEX.INC ( t, [@e], 0.98 ) * 1.15
			VAR mh = MAXX ( t, [@h] )
			RETURN
			    IF ( n < 5, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1048 422' width='100%' height='100%'><text x='524' y='211' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Poucas linhas no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1064 438' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='60' y='22' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.4'>INTERVALO ENTRE ÔNIBUS</text><text x='60' y='60' font-size='34' font-weight='700' fill='#9AA3C2'>r = "
			    & ( FORMAT ( r_int, "0.00" ) )
			    & "</text><text x='230' y='58' font-size='18' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( SWITCH ( TRUE (), ABS ( r_int ) < 0.2, "quase nenhuma relação", ABS ( r_int ) < 0.5, "relação fraca", ABS ( r_int ) < 0.7, "relação média", "relação forte" ) )
			    & "</text><line x1='60' x2='509' y1='376' y2='376' stroke='#9AA3C2'/><line x1='60' x2='60' y1='74' y2='376' stroke='#9AA3C2'/>"
			    & ( CONCATENATEX ( t, "<circle cx='"
			    & ( FORMAT ( 60 + MIN ( [@r] / mr, 1 ) * 449, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( 376 - MIN ( [@e] / my, 1 ) * 302, "0.0", "en-US" ) )
			    & "' r='"
			    & ( FORMAT ( 2.5 + 8 * SQRT ( DIVIDE ( [@h], mh ) ), "0.0", "en-US" ) )
			    & "' fill='#9AA3C2' fill-opacity='.55' stroke='#0A0E1C' stroke-width='.8'/>", "", [@h], DESC ) )
			    & "<text x='60' y='396' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='middle'>0</text><text x='509' y='396' font-size='14' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( mr, "0" ) )
			    & "</text><text x='284' y='420' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>espera com ônibus regulares (metade do intervalo, min)</text><text x='52' y='381' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>0</text><text x='52' y='79' font-size='14' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( my, "0" ) )
			    & "</text><text x='599' y='22' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.4'>ÔNIBUS COLADOS</text><text x='599' y='60' font-size='34' font-weight='700' fill='#FF6B6B'>r = "
			    & ( FORMAT ( r_col, "0.00" ) )
			    & "</text><text x='769' y='58' font-size='18' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( SWITCH ( TRUE (), ABS ( r_col ) < 0.2, "quase nenhuma relação", ABS ( r_col ) < 0.5, "relação fraca", ABS ( r_col ) < 0.7, "relação média", "relação forte" ) )
			    & "</text><line x1='599' x2='1048' y1='376' y2='376' stroke='#9AA3C2'/><line x1='599' x2='599' y1='74' y2='376' stroke='#9AA3C2'/>"
			    & ( CONCATENATEX ( t, "<circle cx='"
			    & ( FORMAT ( 599 + MIN ( [@c] / mc, 1 ) * 449, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( 376 - MIN ( [@e] / my, 1 ) * 302, "0.0", "en-US" ) )
			    & "' r='"
			    & ( FORMAT ( 2.5 + 8 * SQRT ( DIVIDE ( [@h], mh ) ), "0.0", "en-US" ) )
			    & "' fill='#FF6B6B' fill-opacity='.55' stroke='#0A0E1C' stroke-width='.8'/>", "", [@h], DESC ) )
			    & "<text x='599' y='396' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='middle'>0</text><text x='1048' y='396' font-size='14' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( mc, "0%" ) )
			    & "</text><text x='823' y='420' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>intervalos colados</text><text x='591' y='381' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>0</text><text x='591' y='79' font-size='14' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( my, "0" ) )
			    & "</text><text transform='translate(14,225) rotate(-90)' font-size='15' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>espera extra (min)</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: b467a130-5658-5453-ac74-c21a4cc92e38

	/// Espera extra nos pontos pelo numero de linhas.
	measure 'HTML o que pesa pontos' =
			VAR faixas = DATATABLE ( "rot", STRING, "lo", INTEGER, "hi", INTEGER, "o", INTEGER, {
			        { "1 linha", 1, 1, 1 },
			        { "2 a 3 linhas", 2, 3, 2 },
			        { "4 a 8 linhas", 4, 8, 3 },
			        { "9 ou mais", 9, 999, 4 } } )
			VAR t = FILTER ( ADDCOLUMNS ( faixas, "@e", VAR _lo = [lo] VAR _hi = [hi] RETURN CALCULATE ( [Ponto · espera extra], FILTER ( ALL ( fato_paradas[linhas] ), fato_paradas[linhas] >= _lo && fato_paradas[linhas] <= _hi ) ),
			        "@n", VAR _lo = [lo] VAR _hi = [hi] RETURN CALCULATE ( DISTINCTCOUNT ( fato_paradas[stop_id] ), FILTER ( ALL ( fato_paradas[linhas] ), fato_paradas[linhas] >= _lo && fato_paradas[linhas] <= _hi ) ) ), NOT ISBLANK ( [@e] ) )
			VAR rede = [Ponto · espera extra]
			VAR topo = MAX ( MAXX ( t, [@e] ), rede ) * 1.18
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 584 422' width='100%' height='100%'><text x='292' y='211' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 438' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( t, VAR y = ( [o] - 1 ) * 90.50 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 45.2 - 2, "0.0", "en-US" ) )
			    & "' font-size='19' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( [rot] )
			    & "</text><text x='0' y='"
			    & ( FORMAT ( y + 45.2 + 22, "0.0", "en-US" ) )
			    & "' font-size='14' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( FORMAT ( [@n], "#,0" ) )
			    & " pontos</text><rect x='190' y='"
			    & ( FORMAT ( y + 45.2 - 14, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@e] / topo * 304, "0.0", "en-US" ) )
			    & "' height='24' rx='4' fill='#FFB347'/><text x='"
			    & ( FORMAT ( 200 + [@e] / topo * 304, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 45.2 + 6, "0.0", "en-US" ) )
			    & "' font-size='20' font-weight='700' fill='#FFB347'>+"
			    & ( FORMAT ( [@e], "0.00" ) )
			    & "</text>", "", [o], ASC ) )
			    & "<line x1='"
			    & ( FORMAT ( 190 + rede / topo * 304, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( 190 + rede / topo * 304, "0.0", "en-US" ) )
			    & "' y1='4' y2='358' stroke='#F4F6FB' stroke-opacity='.75' stroke-width='2' stroke-dasharray='6 5'/><text x='"
			    & ( FORMAT ( 190 + rede / topo * 304, "0.0", "en-US" ) )
			    & "' y='378' font-size='14' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>todos: +"
			    & ( FORMAT ( rede, "0.00" ) )
			    & "</text><text x='0' y='418' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>A irregularidade vem da linha: o ponto só junta as linhas que passam nele.</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 57f63c78-247d-5f5b-992c-22061aea529f

	/// Espera extra por tipo de dia.
	measure 'HTML o que pesa dias' =
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_tipo_dia[tipo], dim_tipo_dia[ordem] ), "@e", [Espera extra],
			        "@c", [Colados], "@h", [Horas de serviço] ), NOT ISBLANK ( [@e] ) )
			VAR htot = SUMX ( t, [@h] )
			VAR rede = CALCULATE ( [Espera extra], REMOVEFILTERS ( dim_tipo_dia ) )
			VAR topo = MAX ( MAXX ( t, [@e] ), rede ) * 1.18
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1048 194' width='100%' height='100%'><text x='524' y='97' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1064 210' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( t, VAR y = ( dim_tipo_dia[ordem] - 1 ) * 58.00 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 36.0, "0.0", "en-US" ) )
			    & "' font-size='19' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( dim_tipo_dia[tipo] )
			    & "</text><rect x='250' y='"
			    & ( FORMAT ( y + 18.0, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@e] / topo * 498, "0.0", "en-US" ) )
			    & "' height='22' rx='4' fill='#FFB347'/><text x='"
			    & ( FORMAT ( 260 + [@e] / topo * 498, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 36.0, "0.0", "en-US" ) )
			    & "' font-size='20' font-weight='700' fill='#FFB347'>+"
			    & ( FORMAT ( [@e], "0.00" ) )
			    & "</text><text x='1048' y='"
			    & ( FORMAT ( y + 36.0, "0.0", "en-US" ) )
			    & "' font-size='17' fill='#C9D0E4' text-anchor='end' font-family='Segoe UI, sans-serif'><tspan font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( DIVIDE ( [@h], htot ), "0.0%" ) )
			    & "</tspan> das horas · <tspan font-weight='700' fill='#FF6B6B'>"
			    & ( FORMAT ( [@c], "0%" ) )
			    & "</tspan> colados</text>", "", dim_tipo_dia[ordem], ASC ) )
			    & "<line x1='"
			    & ( FORMAT ( 250 + rede / topo * 498, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( 250 + rede / topo * 498, "0.0", "en-US" ) )
			    & "' y1='2' y2='172' stroke='#F4F6FB' stroke-opacity='.75' stroke-width='2' stroke-dasharray='6 5'/><text x='"
			    & ( FORMAT ( 250 + rede / topo * 498, "0.0", "en-US" ) )
			    & "' y='192' font-size='14' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>todos os dias: +"
			    & ( FORMAT ( rede, "0.00" ) )
			    & "</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 8f6d3014-65b4-5bfa-9dd2-650d9da0a357

	/// Tres leituras do que a pagina mostra.
	measure 'HTML o que pesa leitura' =
			"<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 236' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<circle cx='14' cy='22' r='14' fill='#42D392' fill-opacity='.16' stroke='#42D392'/><text x='14' y='28' font-size='16' font-weight='700' fill='#42D392' text-anchor='middle'>1</text><text x='42' y='28' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Controlar o espaçamento, não só a frota</text><text x='42' y='54' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Mais ônibus numa linha irregular não a deixa regular.</text><circle cx='14' cy='95' r='14' fill='#42D392' fill-opacity='.16' stroke='#42D392'/><text x='14' y='101' font-size='16' font-weight='700' fill='#42D392' text-anchor='middle'>2</text><text x='42' y='101' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Agir linha a linha, não ponto a ponto</text><text x='42' y='127' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Ponto com muitas linhas não espera mais que os outros.</text><circle cx='14' cy='169' r='14' fill='#42D392' fill-opacity='.16' stroke='#42D392'/><text x='14' y='175' font-size='16' font-weight='700' fill='#42D392' text-anchor='middle'>3</text><text x='42' y='175' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Ver o fim de semana à parte</text><text x='42' y='201' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Roda pouca linha frequente: pesa pouco na média da rede.</text>"
			    & "</svg></div>"
		displayFolder: HTML
		lineageTag: 5b9b26a8-9b96-5bf7-b326-e6219e76ca8f

	/// Espera extra por grupo de trajeto e as linhas do grupo.
	measure 'HTML onde agir rotas' =
			VAR rede = [Espera extra da rede no recorte]
			VAR volrede = [Volume da rede]
			VAR horasrede = CALCULATE ( [Horas de serviço], REMOVEFILTERS ( dim_linha ) )
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_linha[trajeto], dim_linha[trajeto_ordem] ),
			        "@e", VAR _tr = dim_linha[trajeto] RETURN CALCULATE ( [Espera extra], REMOVEFILTERS ( dim_linha ), dim_linha[trajeto] = _tr ),
			        "@c", VAR _tr = dim_linha[trajeto] RETURN CALCULATE ( [Colados], REMOVEFILTERS ( dim_linha ), dim_linha[trajeto] = _tr ),
			        "@n", VAR _tr = dim_linha[trajeto] RETURN CALCULATE ( [Linhas medidas], REMOVEFILTERS ( dim_linha ), dim_linha[trajeto] = _tr ),
			        "@p", VAR _tr = dim_linha[trajeto] RETURN CALCULATE ( DIVIDE ( [Volume], volrede ), REMOVEFILTERS ( dim_linha ), dim_linha[trajeto] = _tr ),
			        "@hp", VAR _tr = dim_linha[trajeto] RETURN CALCULATE ( DIVIDE ( [Horas de serviço], horasrede ), REMOVEFILTERS ( dim_linha ), dim_linha[trajeto] = _tr ) ),
			    NOT ISBLANK ( [@e] ) )
			VAR topo = MAX ( MAXX ( t, [@e] ), rede ) * 1.12
			VAR l = CALCULATETABLE ( VALUES ( dim_linha[route_id] ), REMOVEFILTERS ( dim_linha ), dim_linha[trajeto] = "Da estação ao centro" )
			VAR l2 = FILTER ( ADDCOLUMNS ( l, "@v", VAR _rid = dim_linha[route_id] RETURN CALCULATE ( [Volume], REMOVEFILTERS ( dim_linha ), dim_linha[route_id] = _rid ),
			        "@e", VAR _rid = dim_linha[route_id] RETURN CALCULATE ( [Espera extra], REMOVEFILTERS ( dim_linha ), dim_linha[route_id] = _rid ),
			        "@c", VAR _rid = dim_linha[route_id] RETURN CALCULATE ( [Colados], REMOVEFILTERS ( dim_linha ), dim_linha[route_id] = _rid ),
			        "@nome", VAR _rid = dim_linha[route_id] RETURN CALCULATE ( MAX ( dim_linha[route_long_name] ), REMOVEFILTERS ( dim_linha ), dim_linha[route_id] = _rid ) ), NOT ISBLANK ( [@v] ) )
			VAR top5 = TOPN ( 5, l2, [@v], DESC, dim_linha[route_id], ASC )
			VAR r = ADDCOLUMNS ( top5, "@k", VAR _v = [@v] VAR _c = dim_linha[route_id] RETURN COUNTROWS ( FILTER ( top5, [@v] > _v || ( [@v] = _v && dim_linha[route_id] < _c ) ) ) + 1 )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 808 770' width='100%' height='100%'><text x='404' y='385' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 824 786' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>TRAJETO</text><text x='262' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>ESPERA EXTRA (MIN)</text><text x='700' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>COLADOS</text><text x='808' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>% DA REDE</text>"
			    & ( CONCATENATEX ( t, VAR y = 40 + ( dim_linha[trajeto_ordem] - 1 ) * 82 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 30, "0.0", "en-US" ) )
			    & "' font-size='20' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( dim_linha[trajeto] )
			    & "</text><text x='0' y='"
			    & ( FORMAT ( y + 54, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( FORMAT ( [@n], "0" ) )
			    & " linhas · "
			    & ( FORMAT ( [@hp], "0%" ) )
			    & " das horas</text><rect x='262' y='"
			    & ( FORMAT ( y + 16, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@e] / topo * 300, "0.0", "en-US" ) )
			    & "' height='28' rx='5' fill='#FFB347'/><text x='"
			    & ( FORMAT ( 272 + [@e] / topo * 300, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 38, "0.0", "en-US" ) )
			    & "' font-size='22' font-weight='700' fill='#FFB347'>+"
			    & ( FORMAT ( [@e], "0.00" ) )
			    & "</text><text x='700' y='"
			    & ( FORMAT ( y + 38, "0.0", "en-US" ) )
			    & "' font-size='20' font-weight='700' fill='#FF6B6B' text-anchor='end'>"
			    & ( FORMAT ( [@c], "0.0%" ) )
			    & "</text><text x='808' y='"
			    & ( FORMAT ( y + 38, "0.0", "en-US" ) )
			    & "' font-size='20' font-weight='700' fill='#F4F6FB' text-anchor='end'>"
			    & ( FORMAT ( [@p], "0%" ) )
			    & "</text><line x1='0' x2='808' y1='"
			    & ( FORMAT ( y + 78, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( y + 78, "0.0", "en-US" ) )
			    & "' stroke='#2A3456' stroke-opacity='.6'/>", "", dim_linha[trajeto_ordem], ASC ) )
			    & "<line x1='"
			    & ( FORMAT ( 262 + rede / topo * 300, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( 262 + rede / topo * 300, "0.0", "en-US" ) )
			    & "' y1='44' y2='366' stroke='#F4F6FB' stroke-opacity='.75' stroke-width='2' stroke-dasharray='6 5'/><text x='"
			    & ( FORMAT ( 262 + rede / topo * 300, "0.0", "en-US" ) )
			    & "' y='386' font-size='14' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>rede: +"
			    & ( FORMAT ( rede, "0.00" ) )
			    & "</text>"
			    & ( CONCATENATEX ( r, VAR yy = 446 + ( [@k] - 1 ) * 34 RETURN "<text x='0' y='"
			    & ( FORMAT ( yy, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='700' fill='#F4F6FB'>"
			    & ( dim_linha[route_id] )
			    & "</text><text x='80' y='"
			    & ( FORMAT ( yy, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( LEN ( [@nome] ) > 50, LEFT ( [@nome], 49 ) & "…", [@nome] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='700' y='"
			    & ( FORMAT ( yy, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='700' fill='#FFB347' text-anchor='end'>+"
			    & ( FORMAT ( [@e], "0.00" ) )
			    & "</text><text x='808' y='"
			    & ( FORMAT ( yy, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='700' fill='#FF6B6B' text-anchor='end'>"
			    & ( FORMAT ( [@c], "0.0%" ) )
			    & "</text>", "", [@k], ASC ) )
			    & "<text x='0' y='416' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.4'>AS DE MAIOR PESO ENTRE AS QUE VÃO DA ESTAÇÃO AO CENTRO</text><text x='0' y='620' font-size='14' font-weight='700' fill='#42D392' text-anchor='start' letter-spacing='1.6'>O QUE FAZER</text><circle cx='11' cy='644' r='11' fill='#42D392' fill-opacity='.16' stroke='#42D392'/><text x='11' y='649' font-size='14' font-weight='700' fill='#42D392' text-anchor='middle'>1</text><text x='32' y='650' font-size='17' font-weight='400' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Seccionar na estação: a linha leva o passageiro até ela e o tronco segue ao centro.</text><circle cx='11' cy='676' r='11' fill='#42D392' fill-opacity='.16' stroke='#42D392'/><text x='11' y='681' font-size='14' font-weight='700' fill='#42D392' text-anchor='middle'>2</text><text x='32' y='682' font-size='17' font-weight='400' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Onde não der: faixa e semáforo no trecho central, e ônibus espaçados antes de entrar nele.</text><text x='0' y='748' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>O grupo sai do nome da linha: estação; centro, Savassi ou hospitais. É associação, não prova de causa:</text><text x='0' y='768' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>antes de mudar uma rota, conferir trajeto, lotação e onde o passageiro desce.</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: edd18196-51c0-59bf-83fe-0fe1bd2cb059

	/// Cinco ajustes na circulacao, com o numero.
	measure 'HTML onde agir operação' =
			VAR tf = ADDCOLUMNS ( ALL ( dim_faixa[faixa], dim_faixa[ordem] ), "@x", [Espera extra], "@h", [Horas de serviço] )
			VAR htot = SUMX ( tf, [@h] )
			VAR mov = FILTER ( tf, NOT ISBLANK ( [@x] ) && DIVIDE ( [@h], htot ) >= 0.10 )
			VAR pior = TOPN ( 1, mov, [@x], DESC, dim_faixa[ordem], ASC )
			VAR melhor = TOPN ( 1, mov, [@x], ASC, dim_faixa[ordem], ASC )
			VAR faixa_max = MAXX ( pior, dim_faixa[faixa] )
			VAR faixa_min = MAXX ( melhor, dim_faixa[faixa] )
			VAR um = ROW ( "@x", MAXX ( pior, [@x] ), "@y", MAXX ( melhor, [@x] ) )
			RETURN
			    IF ( ISBLANK ( [Espera extra] ) || COUNTROWS ( mov ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 824 422' width='100%' height='100%'><text x='412' y='211' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    CONCATENATEX ( um, "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 840 438' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='46' font-size='40' font-weight='700' fill='#42D392'>−"
			    & ( FORMAT ( [Ganho sem colagem], "0.00" ) )
			    & "<tspan font-size='20' dx='6'>min</tspan></text><text x='1' y='70' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>por ida ao ponto</text><text x='236' y='28' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Espaçar os ônibus colados no caminho</text><text x='236' y='52' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Segurar o que encostou no da frente: some "
			    & ( FORMAT ( [Corte sem colagem], "0%" ) )
			    & " da espera extra.</text><text x='236' y='74' font-size='16' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>Controle por GPS no ponto. É o Simulador com 100% dos pares.</text><line x1='0' x2='824' y1='81' y2='81' stroke='#2A3456' stroke-opacity='.7'/><text x='0' y='130' font-size='40' font-weight='700' fill='#FFB347'>"
			    & ( FORMAT ( [Linhas para 80%], "0" ) )
			    & "<tspan font-size='20' dx='6'>linhas</tspan></text><text x='1' y='154' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>de "
			    & ( FORMAT ( [Linhas na rede], "0" ) )
			    & " medidas</text><text x='236' y='112' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Começar por poucas linhas</text><text x='236' y='136' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Elas somam 80% da espera extra do recorte.</text><text x='236' y='158' font-size='16' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>O mesmo esforço de controle alcança mais gente nelas.</text><line x1='0' x2='824' y1='165' y2='165' stroke='#2A3456' stroke-opacity='.7'/><text x='0' y='215' font-size='40' font-weight='700' fill='#FFB347'>+"
			    & ( FORMAT ( [@x], "0.00" ) )
			    & "<tspan font-size='20' dx='6'>min</tspan></text><text x='1' y='239' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( faixa_max )
			    & "</text><text x='236' y='197' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Reforçar o controle no "
			    & ( LOWER ( faixa_max ) )
			    & "</text><text x='236' y='221' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>A maior espera extra entre as faixas de mais serviço (+"
			    & ( FORMAT ( [@y], "0.00" ) )
			    & " no "
			    & ( LOWER ( faixa_min ) )
			    & ").</text><text x='236' y='243' font-size='16' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>Fiscal e regulação onde a irregularidade é maior por passageiro.</text><line x1='0' x2='824' y1='250' y2='250' stroke='#2A3456' stroke-opacity='.7'/><text x='0' y='299' font-size='40' font-weight='700' fill='#FF6B6B'>"
			    & ( FORMAT ( [Colados atrás de colado %], "0%" ) )
			    & "</text><text x='1' y='323' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>dos colados</text><text x='236' y='281' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Despachar com intervalo fixo no terminal</text><text x='236' y='305' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>São comboios de 3 ou mais ônibus, que espaçar no caminho não desfaz.</text><text x='236' y='327' font-size='16' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>O controle começa na saída do terminal, não só no trajeto.</text><line x1='0' x2='824' y1='334' y2='334' stroke='#2A3456' stroke-opacity='.7'/><text x='0' y='384' font-size='40' font-weight='700' fill='#42D392'>"
			    & ( FORMAT ( [Vezes a chance], "0.0" ) )
			    & "<tspan font-size='20' dx='6'>×</tspan></text><text x='1' y='408' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>a chance sem modelo</text><text x='236' y='366' font-size='19' font-weight='600' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>Usar a previsão como lista de prioridade</text><text x='236' y='390' font-size='16' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Dez paradas antes, os alertas do modelo acertam "
			    & ( FORMAT ( [Acerto dos alertas], "0%" ) )
			    & ".</text><text x='236' y='412' font-size='16' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>Mostrar ao controle os de maior risco, sem ação automática.</text>"
			    & "</svg></div>", "" ) )
		displayFolder: HTML
		lineageTag: 0a698630-4b82-51b7-b9da-e27abe475963

	/// Avenidas de maior espera extra nos pontos.
	measure 'HTML onde agir corredores' =
			VAR vias = DATATABLE ( "k", STRING, "rot", STRING, {
			        { "Waldyr Soeiro Emrich", "Av. Waldyr Soeiro Emrich" },
			        { "Cristiano Machado", "Av. Cristiano Machado" },
			        { "Raja Gabaglia", "Av. Raja Gabaglia" },
			        { "Ursula Paulino", "R. Úrsula Paulino" },
			        { "Nossa Senhora do Carmo", "Av. N. Sra. do Carmo" },
			        { "Amazonas", "Av. Amazonas" },
			        { "Dom Pedro II", "Av. Dom Pedro II" },
			        { "Afonso Pena", "Av. Afonso Pena" },
			        { "Carlos Luz", "Av. Pres. Carlos Luz" },
			        { "Antonio Carlos", "Av. Pres. Antônio Carlos" },
			        { "Contorno", "Av. do Contorno" } } )
			VAR t = FILTER ( ADDCOLUMNS ( vias, "@e", VAR _via = [k] RETURN CALCULATE ( [Ponto · espera extra], FILTER ( ALL ( fato_paradas[stop_name] ), CONTAINSSTRING ( fato_paradas[stop_name], _via ) ) ),
			        "@c", VAR _via = [k] RETURN CALCULATE ( [Ponto · colados], FILTER ( ALL ( fato_paradas[stop_name] ), CONTAINSSTRING ( fato_paradas[stop_name], _via ) ) ),
			        "@h", VAR _via = [k] RETURN CALCULATE ( [Ponto · horas], FILTER ( ALL ( fato_paradas[stop_name] ), CONTAINSSTRING ( fato_paradas[stop_name], _via ) ) ) ), [@h] >= 5000 )
			VAR tp = TOPN ( 5, t, [@e], DESC, [k], ASC )
			VAR r = ADDCOLUMNS ( tp, "@k", VAR _v = [@e] VAR _c = [k] RETURN COUNTROWS ( FILTER ( tp, [@e] > _v || ( [@e] = _v && [k] < _c ) ) ) + 1 )
			VAR rede = [Ponto · espera extra]
			VAR topo = MAX ( MAXX ( tp, [@e] ), rede ) * 1.15
			RETURN
			    IF ( COUNTROWS ( tp ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 824 194' width='100%' height='100%'><text x='412' y='97' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 840 210' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( r, VAR y = ( [@k] - 1 ) * 38.80 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 25.4, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( [rot] )
			    & "</text><rect x='300' y='"
			    & ( FORMAT ( y + 9.4, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@e] / topo * 330, "0.0", "en-US" ) )
			    & "' height='20' rx='4' fill='#FFB347'/><text x='"
			    & ( FORMAT ( 310 + [@e] / topo * 330, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 25.4, "0.0", "en-US" ) )
			    & "' font-size='19' font-weight='700' fill='#FFB347'>+"
			    & ( FORMAT ( [@e], "0.00" ) )
			    & "</text><text x='824' y='"
			    & ( FORMAT ( y + 25.4, "0.0", "en-US" ) )
			    & "' font-size='17' fill='#C9D0E4' text-anchor='end' font-family='Segoe UI, sans-serif'><tspan font-weight='700' fill='#FF6B6B'>"
			    & ( FORMAT ( [@c], "0%" ) )
			    & "</tspan> colados</text>", "", [@k], ASC ) )
			    & "<line x1='"
			    & ( FORMAT ( 300 + rede / topo * 330, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( 300 + rede / topo * 330, "0.0", "en-US" ) )
			    & "' y1='2' y2='192' stroke='#F4F6FB' stroke-opacity='.75' stroke-width='2' stroke-dasharray='6 5'/>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 2636d0cc-885a-5615-9713-d7d183254bd7

	column x
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7eee01a0-c4d9-51be-8466-e3f79bd40412
		summarizeBy: none
		sourceColumn: [x]

		annotation SummarizationSetBy = User

	partition _Medidas = calculated
		mode: import
