/// So medidas. Todo numero do relatorio sai daqui.
table _Medidas
	lineageTag: 430f70f9-20d9-5a6e-9e1b-69b8f13253b8

	/// Grupos linha x sentido x parada x dia x faixa com 3 ou mais intervalos.
	measure Grupos = SUM ( fato_linha[grupos] )
		formatString: #,0
		displayFolder: Base
		lineageTag: badd51d5-93b3-580c-83a1-9c7b4df30c87

	/// Intervalos validos entre onibus da mesma linha (headways).
	measure Intervalos = SUM ( fato_linha[n] )
		formatString: #,0
		displayFolder: Base
		lineageTag: 80eb04f7-d1af-52d1-8645-f0c21234eb5b

	/// Tempo coberto pelos intervalos medidos, em horas.
	measure 'Horas de serviço' = SUM ( fato_linha[soma] ) / 3600
		formatString: #,0
		displayFolder: Base
		lineageTag: 71ac5f1f-c90b-5682-9a43-bb5e01c45c49

	/// Espera media com os mesmos onibus em intervalos iguais (min). sum(soma2_n) / 2 / sum(soma) / 60.
	measure 'Espera regular' = DIVIDE ( SUM ( fato_linha[soma2_n] ), SUM ( fato_linha[soma] ) ) / 2 / 60
		formatString: 0.00
		displayFolder: Base
		lineageTag: a513eeed-9d89-5217-bdde-28b2256b135e

	/// Espera a mais por passageiro, so pela irregularidade dos intervalos (min). sum(dev2) / 2 / sum(soma) / 60.
	measure 'Espera extra' = DIVIDE ( SUM ( fato_linha[dev2] ), SUM ( fato_linha[soma] ) ) / 2 / 60
		formatString: 0.00
		displayFolder: Base
		lineageTag: ed03d157-7527-5e90-9a1f-9fa0f9d4be32

	/// Espera extra vezes horas de servico (min x h). Ordena linhas e pontos pelo peso na rede.
	measure Volume = SUM ( fato_linha[dev2] ) / 2 / 60 / 3600
		formatString: #,0
		displayFolder: Base
		lineageTag: ece907eb-ffaa-58ee-a91e-d2db56e05a71

	/// Intervalos menores que 1/4 do intervalo medio do grupo.
	measure Colados = DIVIDE ( SUM ( fato_linha[colados] ), SUM ( fato_linha[n] ) )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 62cbeb3b-1c29-577b-b15a-94f609798c43

	/// Intervalos menores que 60 segundos.
	measure 'Abaixo de 60 s' = DIVIDE ( SUM ( fato_linha[abaixo_60s] ), SUM ( fato_linha[n] ) )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 0cbf5b0c-1034-5b62-a553-fd1ab901a954

	/// Parte da espera extra que some se o onibus atrasado passasse no meio do caminho entre os dois.
	measure 'Corte sem colagem' = DIVIDE ( SUM ( fato_linha[reducao] ), SUM ( fato_linha[dev2] ) )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 4d8fa3b3-8665-5093-a3f9-c1e08f6036db

	/// Quantidade de intervalos colados.
	measure 'Intervalos colados' = SUM ( fato_linha[colados] )
		formatString: #,0
		displayFolder: Base
		lineageTag: e09f6b0f-5ff8-5e86-9af1-13502bab39f6

	/// Colados com o intervalo anterior nao colado.
	measure 'Pares colados' = SUM ( fato_linha[pares] )
		formatString: #,0
		displayFolder: Base
		lineageTag: c65e78a9-e39d-5b80-9966-fe777914bdf0

	/// Colados no primeiro intervalo do grupo.
	measure 'Colado no início' = SUM ( fato_linha[pulo_primeiro] )
		formatString: #,0
		displayFolder: Base
		lineageTag: cffa51c4-2dc4-5c52-b6c9-1cf5d42b0cda

	/// Terceiro onibus em diante de um comboio.
	measure 'Colado atrás de colado' = SUM ( fato_linha[pulo_colado] )
		formatString: #,0
		displayFolder: Base
		lineageTag: 33fbba70-dd64-54a2-bc05-8e4800f43802

	/// Quanto o erro de estimar a hora de passagem infla a espera extra (min).
	measure 'Viés de interpolação' = DIVIDE ( SUM ( fato_linha[var_n] ), SUM ( fato_linha[soma] ) ) / 60
		formatString: 0.000
		displayFolder: Base
		lineageTag: 1a2415ba-f82e-512c-8494-cae1045db195

	/// Vies de interpolacao como parte da espera extra.
	measure 'Viés de interpolação %' = DIVIDE ( SUM ( fato_linha[var_n] ), SUM ( fato_linha[dev2] ) / 2 )
		formatString: 0.0%
		displayFolder: Base
		lineageTag: 9fad3bdb-9022-5e57-8b0a-f2f3102dd1d5

	/// Espera media no ponto (min).
	measure 'Espera média' = [Espera regular] + [Espera extra]
		formatString: 0.00
		displayFolder: Leitura
		lineageTag: e4430aee-d58f-5f06-8659-b79300f7aa7b

	/// Espera extra sobre a espera regular.
	measure 'Custo da irregularidade' = DIVIDE ( [Espera extra], [Espera regular] )
		formatString: +0%;-0%;0%
		displayFolder: Leitura
		lineageTag: 527b346e-6b29-58ad-98c4-f4cefe7995fd

	/// Dos colados, quantos sao o 3o onibus em diante (fora da conta do corte).
	measure 'Colados atrás de colado %' = DIVIDE ( [Colado atrás de colado], [Pares colados] + [Colado no início] + [Colado atrás de colado] )
		formatString: 0.0%
		displayFolder: Leitura
		lineageTag: fb5aeefe-628b-523a-ba5e-d3b0521109bb

	/// Linhas com intervalo medido no recorte.
	measure 'Linhas medidas' = DISTINCTCOUNT ( fato_linha[route_id] )
		formatString: #,0
		displayFolder: Leitura
		lineageTag: 14bcb5d8-06a1-5fc7-9a2b-9009dd8d4987

	/// Dias com intervalo medido no recorte.
	measure 'Dias medidos' = DISTINCTCOUNT ( fato_linha[data_bh] )
		formatString: #,0
		displayFolder: Leitura
		lineageTag: a2c34384-d467-5dd3-aaae-15f915fa0b76

	/// Volume da rede inteira no recorte, sem o filtro de linha.
	measure 'Volume da rede' = CALCULATE ( [Volume], REMOVEFILTERS ( dim_linha ) )
		formatString: #,0
		displayFolder: Leitura
		lineageTag: e5822c17-7e28-5522-bee0-0e43fd77b0ad

	/// Parte da espera extra da rede que esta na linha (ou no recorte).
	measure 'Parte da espera extra' = DIVIDE ( [Volume], [Volume da rede] )
		formatString: 0.0%
		displayFolder: Leitura
		lineageTag: 3c2aa095-180c-5488-9a02-b1992d92c684

	/// Posicao da linha pelo volume, entre todas as linhas da rede no recorte.
	measure 'Posição' =
			VAR v = [Volume]
			RETURN
			    IF ( NOT ISBLANK ( v ) && HASONEVALUE ( dim_linha[route_id] ),
			        COUNTROWS ( FILTER ( ALL ( dim_linha ), [Volume] > v ) ) + 1 )
		formatString: 0
		displayFolder: Leitura
		lineageTag: 7d1d1f69-22ad-59f2-8709-84f7fe67d59e

	/// Linhas com espera medida no recorte, sem o filtro de linha.
	measure 'Linhas na rede' = COUNTROWS ( FILTER ( ALL ( dim_linha ), NOT ISBLANK ( [Volume] ) ) )
		formatString: 0
		displayFolder: Leitura
		lineageTag: b5073ea2-9f18-5423-bc3f-5c5e45cd55f2

	/// Posicao no ranking em texto: 12a de 311.
	measure 'Posição texto' = IF ( NOT ISBLANK ( [Posição] ), FORMAT ( [Posição], "0" ) & "ª de " & FORMAT ( [Linhas na rede], "0" ) )
		displayFolder: Leitura
		lineageTag: 65d30f25-b2ff-54cf-bcac-12e43a3458f9

	/// Menor numero de linhas que somam 80% da espera extra da rede (ordem pelo volume).
	measure 'Linhas para 80%' =
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_linha ), "@v", [Volume] ), NOT ISBLANK ( [@v] ) )
			VAR tot = SUMX ( t, [@v] )
			VAR t2 = ADDCOLUMNS ( t, "@antes", VAR x = [@v] RETURN SUMX ( FILTER ( t, [@v] > x ), [@v] ) )
			RETURN
			    IF ( tot > 0, COUNTROWS ( FILTER ( t2, [@antes] < 0.8 * tot ) ) )
		formatString: 0
		displayFolder: Leitura
		lineageTag: 2d791a3d-ab04-5e29-8bde-45d78ad81884

	/// Linhas para 80% sobre as linhas da rede.
	measure 'Linhas para 80% %' = DIVIDE ( [Linhas para 80%], [Linhas na rede] )
		formatString: 0%
		displayFolder: Leitura
		lineageTag: 2ddfa76b-933e-5fb6-9825-af4725336b39

	/// Parte da espera extra somada desta linha para cima no ranking (curva de Pareto).
	measure 'Parte acumulada' =
			VAR v = [Volume]
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_linha ), "@v", [Volume] ), NOT ISBLANK ( [@v] ) )
			VAR tot = SUMX ( t, [@v] )
			RETURN
			    IF ( NOT ISBLANK ( v ) && HASONEVALUE ( dim_linha[route_id] ),
			        DIVIDE ( SUMX ( FILTER ( t, [@v] >= v ), [@v] ), tot ) )
		formatString: 0%
		displayFolder: Leitura
		lineageTag: 1c4fde3c-c86c-5bf5-9226-c77e920d63cf

	/// Parte da espera extra so das linhas do grafico de concentracao (as do 80% e mais 15).
	measure 'Pareto parte' = IF ( [Posição] <= [Linhas para 80%] + 15, [Parte da espera extra] )
		formatString: 0.0%
		isHidden
		displayFolder: Leitura
		lineageTag: 4915a045-bc68-5a4a-92db-247951be862f

	/// Parte acumulada so das linhas do grafico de concentracao.
	measure 'Pareto acumulada' = IF ( [Posição] <= [Linhas para 80%] + 15, [Parte acumulada] )
		formatString: 0%
		isHidden
		displayFolder: Leitura
		lineageTag: d5044fc2-0fe0-5703-b94a-1fb0f29c0a27

	/// Referencia de 80% no grafico de concentracao.
	measure 'Linha de 80%' = IF ( NOT ISBLANK ( [Pareto parte] ), 0.8 )
		formatString: 0%
		isHidden
		displayFolder: Leitura
		lineageTag: 8dcfa1cc-04c9-5484-8286-badd929651c8

	/// Espera extra so nas 30 linhas de maior volume (mapa de calor linha x faixa).
	measure 'Calor top' = IF ( [Posição] <= 30, [Espera extra] )
		formatString: 0.0
		displayFolder: Leitura
		lineageTag: 9f270fff-4c1f-5856-a764-af43cbc0b7e6

	/// Dias de calendario no periodo.
	measure 'Dias no período' =
			VAR ini = MIN ( dim_data[data] )
			VAR fim = MAX ( dim_data[data] )
			RETURN IF ( NOT ISBLANK ( ini ), INT ( fim - ini ) + 1 )
		formatString: 0
		displayFolder: Comparação
		lineageTag: db0baf25-460c-5889-9640-a59fc0a1b115

	/// Espera extra nos dias logo antes do periodo, com o mesmo numero de dias. Em branco se faltar dado.
	measure 'Espera extra anterior' =
			VAR ini = MIN ( dim_data[data] )
			VAR fim = MAX ( dim_data[data] )
			VAR n = INT ( fim - ini ) + 1
			VAR primeiro = CALCULATE ( MIN ( dim_data[data] ), REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
			RETURN
			    IF ( ini - n >= primeiro,
			        CALCULATE ( [Espera extra], REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ),
			            dim_data[data] >= ini - n, dim_data[data] <= ini - 1 ) )
		formatString: 0.00
		displayFolder: Comparação
		lineageTag: 36c7bafb-194f-52d6-945e-84fff1cce692

	/// Espera extra menos a do periodo anterior (min).
	measure 'Δ espera extra' =
			VAR a = [Espera extra anterior]
			RETURN IF ( NOT ISBLANK ( a ), [Espera extra] - a )
		formatString: +0.00;-0.00;0.00
		displayFolder: Comparação
		lineageTag: 90584f31-51c6-5031-8e79-9e353dd8f8ae

	/// Variacao da espera extra contra o periodo anterior, em texto.
	measure 'Texto da variação' =
			VAR d = [Δ espera extra]
			RETURN
			    IF ( ISBLANK ( d ), "Sem período anterior completo para comparar",
			        IF ( d > 0, "▲ +", "▼ −" ) & FORMAT ( ABS ( d ), "0.00" ) & " min contra os "
			            & [Dias no período] & " dias anteriores" )
		displayFolder: Comparação
		lineageTag: 8c0ea6cb-9224-5c61-8678-ffccb398e4d0

	/// Vermelho quando a espera extra subiu, verde quando caiu.
	measure 'Cor da variação' = IF ( [Δ espera extra] > 0, "#FF6B6B", IF ( [Δ espera extra] < 0, "#42D392", "#C9D0E4" ) )
		isHidden
		displayFolder: Cores
		lineageTag: bedffc0f-4cc5-56ba-ad31-3ae07e88ed9f

	/// A espera extra do recorte, para o numero grande da capa.
	measure 'Espera extra texto' = IF ( NOT ISBLANK ( [Espera extra] ), "+" & FORMAT ( [Espera extra], "0.00" ) & " min" )
		displayFolder: Textos
		lineageTag: 502b1eb1-3edf-5350-a8e7-a480ea77b03c

	/// Filtros em vigor, em uma linha.
	measure Recorte =
			VAR ini = MIN ( dim_data[data] )
			VAR fim = MAX ( dim_data[data] )
			VAR tipo = IF ( HASONEVALUE ( dim_tipo_dia[tipo] ), LOWER ( VALUES ( dim_tipo_dia[tipo] ) ), "todos os dias" )
			VAR freq = IF ( HASONEVALUE ( dim_frequencia[frequencia] ),
			    IF ( VALUES ( dim_frequencia[frequencia] ) = "alta", "alta frequência", "baixa frequência" ), "todas as frequências" )
			VAR nl = COUNTROWS ( VALUES ( dim_linha[route_id] ) )
			VAR linhas = IF ( ISFILTERED ( dim_linha ), FORMAT ( nl, "0" ) & IF ( nl = 1, " linha escolhida", " linhas escolhidas" ), "rede inteira" )
			RETURN
			    UPPER ( FORMAT ( ini, "dd/mm" ) & " a " & FORMAT ( fim, "dd/mm" ) & "  ·  " & tipo & "  ·  " & freq & "  ·  " & linhas )
		displayFolder: Textos
		lineageTag: 3f59d1e3-4a15-5d3c-b6df-5e22773edec9

	/// Frase da capa.
	measure 'Frase da espera' =
			IF ( NOT ISBLANK ( [Espera média] ),
			    "Quem chega ao ponto espera em média " & FORMAT ( [Espera média], "0.0" ) & " min pelo ônibus. "
			    & "Com os mesmos ônibus em intervalos iguais, seriam " & FORMAT ( [Espera regular], "0.0" ) & " min." )
		displayFolder: Textos
		lineageTag: 007480a9-56c2-53ed-ac64-8de6f3aa8865

	/// Selo do cabecalho: ultimo dia com dado e hora da ultima exportacao (horario de BH).
	measure 'Dados até' =
			VAR ate = MAX ( cargas[ate] )
			VAR quando = MAX ( cargas[carregado_em] )
			RETURN "DADOS ATÉ " & FORMAT ( ate, "dd/mm/yyyy" ) & "  ·  CARGA " & FORMAT ( quando, "dd/mm hh:nn" )
		displayFolder: Textos
		lineageTag: 07e61066-ddcb-5e6d-ba8a-9f1d9e7f42e2

	/// Nome da linha em foco (ficha e dica).
	measure 'Nome da linha' = IF ( HASONEVALUE ( dim_linha[route_id] ), VALUES ( dim_linha[route_long_name] ) )
		displayFolder: Textos
		lineageTag: 9e98043f-1cc9-536b-ab68-a60a9d18bbd8

	/// Codigo da linha em foco.
	measure 'Linha em foco' = IF ( HASONEVALUE ( dim_linha[route_id] ), "LINHA " & VALUES ( dim_linha[route_id] ) )
		displayFolder: Textos
		lineageTag: 89c21cf2-e47a-5ba3-9470-0f9906bbe260

	/// Legenda do numero da concentracao.
	measure 'Texto 80%' =
			"de " & FORMAT ( [Linhas na rede], "0" ) & " linhas somam 80% da espera extra da rede ("
			    & FORMAT ( [Linhas para 80% %], "0%" ) & " das linhas)"
		displayFolder: Textos
		lineageTag: d9637c5a-57ae-5605-9244-c5cd072372e3

	/// Evento achado em noticias, ou falha de GPS das linhas S, no dia.
	measure 'Evento do dia' =
			IF ( HASONEVALUE ( dim_data[data] ),
			    VAR e = VALUES ( dim_data[evento] )
			    VAR f = VALUES ( dim_data[falha_gps_s] )
			    RETURN IF ( e <> "", e, IF ( f, "GPS das suplementares falhou em parte do dia" ) ) )
		displayFolder: Textos
		lineageTag: 6a2379e1-75cb-5dd9-b603-baf8421806b1

	/// Espera extra so nos dias com evento: vira coluna dourada no grafico dia a dia.
	measure 'Marca de evento' = IF ( HASONEVALUE ( dim_data[data] ) && VALUES ( dim_data[evento] ) <> "", [Espera extra] )
		formatString: 0.00
		displayFolder: Textos
		lineageTag: a2d77531-e97a-5c31-9d0c-2b1203a8af51

	/// Espera extra em texto, com losango nos dias de evento (calendario).
	measure 'Calor texto' =
			VAR v = [Espera extra]
			VAR e = IF ( HASONEVALUE ( dim_data[data] ), VALUES ( dim_data[evento] ) )
			RETURN IF ( NOT ISBLANK ( v ), FORMAT ( v, "0.0" ) & IF ( e <> "", " ◆" ) )
		displayFolder: Textos
		lineageTag: 42babedd-81f4-5597-bbc3-9fbd4314ded7

	/// Texto do mapa de calor linha x faixa.
	measure 'Calor top texto' =
			VAR v = [Calor top]
			RETURN IF ( NOT ISBLANK ( v ), FORMAT ( v, "0.0" ) )
		displayFolder: Textos
		lineageTag: 3e770307-9e2b-5010-a5c4-11d5922e1e8a

	/// Espera extra da linha em cada dia do periodo, separada por ponto e virgula (vazio no dia sem dado). Alimenta a linha do cartao do carrossel.
	measure 'Carrossel tendência' =
			IF ( NOT ISBLANK ( [Volume] ),
			    CONCATENATEX ( VALUES ( dim_data[data] ),
			        VAR v = [Espera extra]
			        RETURN IF ( ISBLANK ( v ), "", FORMAT ( v, "0.000", "en-US" ) ),
			        ";", dim_data[data], ASC ) )
		isHidden
		displayFolder: Carrossel
		lineageTag: 590670e0-d078-5dab-86db-cdf503e161d7

	/// Numeros da rede inteira para o cartao Rede inteira do carrossel: espera media; espera extra; colados; corte; linhas; inicio; fim | espera extra por dia. Ignora o filtro de linha.
	measure 'Carrossel rede' =
			IF ( NOT ISBLANK ( [Volume] ),
			    CALCULATE (
			        FORMAT ( [Espera média], "0.000", "en-US" ) & ";" & FORMAT ( [Espera extra], "0.000", "en-US" ) & ";"
			            & FORMAT ( [Colados], "0.0000", "en-US" ) & ";" & FORMAT ( [Corte sem colagem], "0.0000", "en-US" ) & ";"
			            & FORMAT ( [Linhas na rede], "0" ) & ";" & FORMAT ( MIN ( dim_data[data] ), "dd/mm" ) & ";"
			            & FORMAT ( MAX ( dim_data[data] ), "dd/mm" ) & "|" & CONCATENATEX ( VALUES ( dim_data[data] ),
			        VAR v = [Espera extra]
			        RETURN IF ( ISBLANK ( v ), "", FORMAT ( v, "0.000", "en-US" ) ),
			        ";", dim_data[data], ASC ),
			        REMOVEFILTERS ( dim_linha ) ) )
		isHidden
		displayFolder: Carrossel
		lineageTag: 9c52740d-5a80-5d9b-9345-fccc71b99149

	/// Fundo do mapa de calor pela espera extra.
	measure 'Cor do calor' =
			VAR v = [Espera extra]
			RETURN
			    IF ( ISBLANK ( v ), BLANK (),
			        SWITCH ( TRUE (),
			            v < 0.5, "#18203A",
			            v < 1.0, "#1F2B47",
			            v < 1.5, "#2E3550",
			            v < 2.0, "#4A3F4F",
			            v < 2.5, "#6E4A45",
			            v < 3.0, "#94563A",
			            v < 3.5, "#B9652F",
			            v < 4.5, "#DE7A2C",
			            v < 6.0, "#F59A33",
			            "#FFC15A"
			        )
			    )
		isHidden
		displayFolder: Cores
		lineageTag: b49dfd5a-744b-5f84-9bf3-26a23cd8a1f1

	/// Letra do mapa de calor.
	measure 'Letra do calor' =
			VAR v = [Espera extra]
			RETURN
			    IF ( ISBLANK ( v ), BLANK (),
			        SWITCH ( TRUE (),
			            v < 0.5, "#F4F6FB",
			            v < 1.0, "#F4F6FB",
			            v < 1.5, "#F4F6FB",
			            v < 2.0, "#F4F6FB",
			            v < 2.5, "#F4F6FB",
			            v < 3.0, "#F4F6FB",
			            v < 3.5, "#0A0E1C",
			            v < 4.5, "#0A0E1C",
			            v < 6.0, "#0A0E1C",
			            "#0A0E1C"
			        )
			    )
		isHidden
		displayFolder: Cores
		lineageTag: b88bcd94-da6a-5041-988e-912c1e46f9fc

	/// Fundo do mapa linha x faixa.
	measure 'Cor do calor top' =
			VAR v = [Calor top]
			RETURN
			    IF ( ISBLANK ( v ), BLANK (),
			        SWITCH ( TRUE (),
			            v < 0.5, "#18203A",
			            v < 1.0, "#1F2B47",
			            v < 1.5, "#2E3550",
			            v < 2.0, "#4A3F4F",
			            v < 2.5, "#6E4A45",
			            v < 3.0, "#94563A",
			            v < 3.5, "#B9652F",
			            v < 4.5, "#DE7A2C",
			            v < 6.0, "#F59A33",
			            "#FFC15A"
			        )
			    )
		isHidden
		displayFolder: Cores
		lineageTag: badba419-4c10-5143-8fab-6b604b0ec483

	/// Letra do mapa linha x faixa.
	measure 'Letra do calor top' =
			VAR v = [Calor top]
			RETURN
			    IF ( ISBLANK ( v ), BLANK (),
			        SWITCH ( TRUE (),
			            v < 0.5, "#F4F6FB",
			            v < 1.0, "#F4F6FB",
			            v < 1.5, "#F4F6FB",
			            v < 2.0, "#F4F6FB",
			            v < 2.5, "#F4F6FB",
			            v < 3.0, "#F4F6FB",
			            v < 3.5, "#0A0E1C",
			            v < 4.5, "#0A0E1C",
			            v < 6.0, "#0A0E1C",
			            "#0A0E1C"
			        )
			    )
		isHidden
		displayFolder: Cores
		lineageTag: 74f8469c-f14c-5d03-8067-e253c669516e

	/// Vermelho: muitos colados e muita espera; ambar: espera alta sem colagem; azul: colados sem espera alta; cinza: abaixo da rede nas duas.
	measure 'Cor do quadrante' =
			VAR x = [Colados]
			VAR y = [Espera extra]
			VAR rx = CALCULATE ( [Colados], REMOVEFILTERS ( dim_linha ) )
			VAR ry = CALCULATE ( [Espera extra], REMOVEFILTERS ( dim_linha ) )
			RETURN
			    SWITCH ( TRUE (),
			        x >= rx && y >= ry, "#FF6B6B",
			        y >= ry, "#FFB347",
			        x >= rx, "#6AA8FF",
			        "#9AA3C2" )
		isHidden
		displayFolder: Cores
		lineageTag: 736c9970-0048-54d1-8900-6b5877fc964c

	/// Referencia vertical do grafico de quadrantes.
	measure 'Colados da rede' = CALCULATE ( [Colados], REMOVEFILTERS ( dim_linha ) )
		formatString: 0.0%
		isHidden
		displayFolder: Cores
		lineageTag: b881b147-71a5-55a4-a60f-534721e2ffe0

	/// Referencia horizontal do grafico de quadrantes.
	measure 'Espera extra da rede' = CALCULATE ( [Espera extra], REMOVEFILTERS ( dim_linha ) )
		formatString: 0.00
		isHidden
		displayFolder: Cores
		lineageTag: 99529b33-ffc1-5672-99e0-1d8ab551b1e5

	/// Mini grafico da espera extra por dia no periodo (escala de 0 a 6 min ou ao maximo da linha). Tracejado: a rede.
	measure 'Tendência' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@v", [Espera extra] ), NOT ISBLANK ( [@v] ) )
			VAR d0 = MINX ( t, dim_data[data] )
			VAR d1 = MAXX ( t, dim_data[data] )
			VAR topo = MAX ( 6, MAXX ( t, [@v] ) )
			VAR rede = CALCULATE ( [Espera extra], REMOVEFILTERS ( dim_linha ) )
			VAR yr = FORMAT ( 39 - DIVIDE ( rede, topo ) * 34, "0.0", "en-US" )
			VAR pts = CONCATENATEX ( t,
			        FORMAT ( 4 + DIVIDE ( INT ( dim_data[data] - d0 ), MAX ( 1, INT ( d1 - d0 ) ) ) * 212, "0.0", "en-US" ) & "," &
			        FORMAT ( 39 - DIVIDE ( [@v], topo ) * 34, "0.0", "en-US" ),
			        " ", dim_data[data], ASC )
			VAR ultimo = MAXX ( TOPN ( 1, t, dim_data[data], DESC ), [@v] )
			VAR yu = FORMAT ( 39 - DIVIDE ( ultimo, topo ) * 34, "0.0", "en-US" )
			RETURN
			    IF ( COUNTROWS ( t ) >= 2,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='44' viewBox='0 0 220 44'>" & "<line x1='0' x2='220' y1='" & yr & "' y2='" & yr & "' stroke='%239AA3C2' stroke-width='1' stroke-dasharray='3 3'/>" & "<polyline points='" & pts & "' fill='none' stroke='%23FFB347' stroke-width='2.2' stroke-linejoin='round'/>" & "<circle cx='216' cy='" & yu & "' r='3.5' fill='%23FFB347'/>" & "</svg>" )
		dataCategory: ImageUrl
		displayFolder: SVG
		lineageTag: 6d446c16-b14a-50cb-a337-660b6917cd5b

	/// Espera extra no ponto, ultimos 28 dias (min).
	measure 'Ponto · espera extra' = DIVIDE ( SUM ( fato_paradas[dev2] ), SUM ( fato_paradas[soma] ) ) / 2 / 60
		formatString: 0.00
		displayFolder: Pontos
		lineageTag: d5d2c419-508e-5513-aaa6-4a0079eb5ec2

	/// Espera regular no ponto (min).
	measure 'Ponto · espera regular' = DIVIDE ( SUM ( fato_paradas[soma2_n] ), SUM ( fato_paradas[soma] ) ) / 2 / 60
		formatString: 0.00
		displayFolder: Pontos
		lineageTag: 13dc8875-fd1e-50e5-8484-e08959118152

	/// Colados no ponto.
	measure 'Ponto · colados' = DIVIDE ( SUM ( fato_paradas[colados] ), SUM ( fato_paradas[n] ) )
		formatString: 0.0%
		displayFolder: Pontos
		lineageTag: 6691698f-716e-5bbb-a4ad-ab7c409a4673

	/// Horas de servico medidas no ponto.
	measure 'Ponto · horas' = SUM ( fato_paradas[soma] ) / 3600
		formatString: #,0
		displayFolder: Pontos
		lineageTag: 9ef7d727-bf77-5d13-bb15-75ff31a96b4b

	/// Espera extra x horas no ponto.
	measure 'Ponto · volume' = SUM ( fato_paradas[dev2] ) / 2 / 60 / 3600
		formatString: #,0
		displayFolder: Pontos
		lineageTag: 54ad2b09-a091-5adc-9213-6b7f839c4027

	/// Linhas que passam no ponto (maior contagem entre tipo de dia e frequencia).
	measure 'Ponto · linhas' = MAX ( fato_paradas[linhas] )
		formatString: 0
		displayFolder: Pontos
		lineageTag: ad062764-9e9e-595c-9e75-9de9c3607b4f

	/// Espera extra so dos pontos com 25 horas ou mais (mapa e ranking).
	measure 'Ponto · mapa espera' = IF ( HASONEVALUE ( fato_paradas[stop_id] ) && [Ponto · horas] >= 25, [Ponto · espera extra] )
		formatString: 0.00
		displayFolder: Pontos
		lineageTag: 7d71172b-0112-5e44-99a8-eba9e7423c82

	/// Latitude do ponto.
	measure 'Ponto · latitude' = IF ( NOT ISBLANK ( [Ponto · mapa espera] ), MAX ( fato_paradas[stop_lat] ) )
		formatString: 0.0000
		displayFolder: Pontos
		lineageTag: e1c0310c-529e-5e78-8151-df512298337e

	/// Longitude do ponto.
	measure 'Ponto · longitude' = IF ( NOT ISBLANK ( [Ponto · mapa espera] ), MAX ( fato_paradas[stop_lon] ) )
		formatString: 0.0000
		displayFolder: Pontos
		lineageTag: 84355d52-1f97-56f7-b3a0-b49d27007f81

	/// Pontos com 25 horas de servico ou mais na janela.
	measure 'Pontos no mapa' = COUNTROWS ( FILTER ( VALUES ( fato_paradas[stop_id] ), CALCULATE ( SUM ( fato_paradas[soma] ) ) / 3600 >= 25 ) )
		formatString: #,0
		displayFolder: Pontos
		lineageTag: acda03b8-8c20-53a8-93e3-8db30fa8f445

	/// Parte da espera extra dos pontos do mapa que esta nos 10 piores.
	measure 'Top 10 pontos parte' =
			VAR t = ADDCOLUMNS ( FILTER ( VALUES ( fato_paradas[stop_id] ), CALCULATE ( SUM ( fato_paradas[soma] ) ) / 3600 >= 25 ), "@v", [Ponto · volume] )
			RETURN DIVIDE ( SUMX ( TOPN ( 10, t, [@v], DESC ), [@v] ), SUMX ( t, [@v] ) )
		formatString: 0.0%
		displayFolder: Pontos
		lineageTag: e1e9d26e-ff98-5376-9ddc-d589989b180b

	/// Espera extra media dos pontos do mapa.
	measure 'Ponto · espera extra rede' =
			VAR t = FILTER ( VALUES ( fato_paradas[stop_id] ), CALCULATE ( SUM ( fato_paradas[soma] ) ) / 3600 >= 25 )
			RETURN DIVIDE ( CALCULATE ( SUM ( fato_paradas[dev2] ), t ), CALCULATE ( SUM ( fato_paradas[soma] ), t ) ) / 2 / 60
		formatString: 0.00
		displayFolder: Pontos
		lineageTag: 7cebaae4-b7e1-53a4-9eb5-f8cb933a371d

	/// Janela de 28 dias dos pontos.
	measure 'Janela dos pontos' = "DE " & FORMAT ( MIN ( fato_paradas[janela_ini] ), "dd/mm" ) & " A " & FORMAT ( MAX ( fato_paradas[janela_fim] ), "dd/mm" )
		displayFolder: Pontos
		lineageTag: a3279218-3944-51e4-9ef9-816374c3d529

	/// Parte da espera extra dos pontos do mapa que esta no ponto.
	measure 'Ponto · parte' =
			VAR v = IF ( NOT ISBLANK ( [Ponto · mapa espera] ), [Ponto · volume] )
			VAR tot = CALCULATE ( SUMX ( FILTER ( VALUES ( fato_paradas[stop_id] ), CALCULATE ( SUM ( fato_paradas[soma] ) ) / 3600 >= 25 ), [Ponto · volume] ), REMOVEFILTERS ( fato_paradas[stop_id], fato_paradas[stop_name] ) )
			RETURN DIVIDE ( v, tot )
		formatString: 0.0%
		displayFolder: Pontos
		lineageTag: 97ddcacc-bd9b-52f2-814e-9d604831d167

	/// Cor do ponto no mapa.
	measure 'Cor do ponto' =
			VAR v = [Ponto · mapa espera]
			RETURN
			    IF ( ISBLANK ( v ), BLANK (),
			        SWITCH ( TRUE (),
			            v < 0.5, "#18203A",
			            v < 1.0, "#1F2B47",
			            v < 1.5, "#2E3550",
			            v < 2.0, "#4A3F4F",
			            v < 2.5, "#6E4A45",
			            v < 3.0, "#94563A",
			            v < 3.5, "#B9652F",
			            v < 4.5, "#DE7A2C",
			            v < 6.0, "#F59A33",
			            "#FFC15A"
			        )
			    )
		isHidden
		displayFolder: Cores
		lineageTag: 326d54c6-55a1-5726-93f7-0f77abdb9ec3

	/// Intervalos medidos na classe.
	measure 'Intervalos na classe' = SUM ( fato_hist[headways] )
		formatString: #,0
		displayFolder: Histograma
		lineageTag: 29f1cd6a-f5c7-5dc7-8607-2304d8e45b9f

	/// Parte dos intervalos na classe (o histograma nao separa por linha).
	measure '% dos intervalos' = DIVIDE ( [Intervalos na classe], CALCULATE ( [Intervalos na classe], REMOVEFILTERS ( dim_classe ) ) )
		formatString: 0.0%
		displayFolder: Histograma
		lineageTag: e6ed0fd1-e9bf-5dc0-933d-b6a0e4cbe932

	/// Vermelho nos colados (menos de 1/4 do medio).
	measure 'Cor da classe' = IF ( MAX ( dim_classe[classe] ) < 5, "#FF6B6B", "#6AA8FF" )
		isHidden
		displayFolder: Cores
		lineageTag: bd559922-ed73-5845-a877-99ae2b52fa66

	/// Alertas no teste (fora da amostra). Ignora o filtro de periodo: o teste foi feito uma vez.
	measure Alertas = CALCULATE ( SUM ( fato_previsao[alertas] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
		formatString: #,0
		displayFolder: Previsão
		lineageTag: 7436fc73-03c5-595e-806d-e69dcc80c8e8

	/// Alertas que chegaram colados.
	measure Acertos = CALCULATE ( SUM ( fato_previsao[acertos] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
		formatString: #,0
		displayFolder: Previsão
		lineageTag: 133a12db-56aa-5eca-8352-47098767d6ff

	/// Onibus que chegaram colados.
	measure Positivos = CALCULATE ( SUM ( fato_previsao[positivos] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
		formatString: #,0
		displayFolder: Previsão
		lineageTag: c39f820d-3a12-5e37-8566-7214052fa3dc

	/// Passagens avaliadas.
	measure Exemplos = CALCULATE ( SUM ( fato_previsao[exemplos] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
		formatString: #,0
		displayFolder: Previsão
		lineageTag: 45f68662-5d01-5940-8b8b-e04f464c6f71

	/// Precisao: dos alertas, quantos acertaram.
	measure 'Acerto dos alertas' = DIVIDE ( [Acertos], [Alertas] )
		formatString: 0.0%
		displayFolder: Previsão
		lineageTag: 7509ad00-6324-50ca-8688-792565f99a93

	/// Revocacao: dos colados, quantos foram avisados.
	measure 'Colados avisados' = DIVIDE ( [Acertos], [Positivos] )
		formatString: 0.0%
		displayFolder: Previsão
		lineageTag: e123d323-feda-53cf-bbaa-ee6c3ecb9212

	/// Chance de um onibus qualquer chegar colado (base).
	measure 'Chance sem modelo' = DIVIDE ( [Positivos], [Exemplos] )
		formatString: 0.0%
		displayFolder: Previsão
		lineageTag: 0940030e-bcca-50ff-a9ca-debb461a8f11

	/// Limiar fixado na validacao.
	measure Limiar = CALCULATE ( MAX ( fato_previsao[limiar] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
		formatString: 0.000
		displayFolder: Previsão
		lineageTag: 5eeab369-1370-5f83-855b-3ecf526715ba

	/// Janela e limiar do teste.
	measure 'Janela do teste' =
			VAR a = CALCULATE ( MIN ( fato_previsao[data_bh] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
			VAR b = CALCULATE ( MAX ( fato_previsao[data_bh] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo ), REMOVEFILTERS ( dim_data ) )
			RETURN "TESTE DE " & FORMAT ( a, "dd/mm" ) & " A " & FORMAT ( b, "dd/mm" ) & "  ·  LIMIAR " & FORMAT ( [Limiar], "0.000" )
		displayFolder: Previsão
		lineageTag: 2d657638-def6-5245-a2c8-2d422b18ad36

	/// Alertas por dia do teste. Tira so a coluna do periodo: REMOVEFILTERS ( sel_periodo ) levaria junto o filtro de dim_data (tabela expandida).
	measure 'Alertas no dia' = CALCULATE ( SUM ( fato_previsao[alertas] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo[periodo] ) )
		formatString: #,0
		isHidden
		displayFolder: Previsão
		lineageTag: 181c1bba-8c7b-5fe1-9532-49287e474809

	/// Acertos por dia do teste.
	measure 'Acertos no dia' = CALCULATE ( SUM ( fato_previsao[acertos] ), fato_previsao[conjunto] = "teste", REMOVEFILTERS ( sel_periodo[periodo] ) )
		formatString: #,0
		isHidden
		displayFolder: Previsão
		lineageTag: 1f5dad26-2491-54ce-92f2-06892825a719

	/// Acerto dos alertas em cada dia do teste.
	measure 'Acerto no dia' = DIVIDE ( [Acertos no dia], [Alertas no dia] )
		formatString: 0%
		isHidden
		displayFolder: Previsão
		lineageTag: 98f7b44a-51b6-5045-987f-612791448469

	/// Quantas vezes o acerto dos alertas supera a chance de um onibus qualquer chegar colado.
	measure 'Vezes a chance' = DIVIDE ( [Acerto dos alertas], [Chance sem modelo] )
		formatString: 0.0
		displayFolder: Previsão
		lineageTag: d5e1c6e4-abcb-5adf-94a1-6935ab5849a4

	/// Leitura do teste do modelo, montada com as medidas.
	measure 'Frase do modelo' =
			"Dos " & FORMAT ( [Alertas], "#,0" ) & " alertas, " & FORMAT ( [Acertos], "#,0" ) & " chegaram colados ("
			    & FORMAT ( [Acerto dos alertas], "0%" ) & "). Sem modelo, a chance de um ônibus chegar colado é de "
			    & FORMAT ( [Chance sem modelo], "0%" ) & ". Uso sugerido: lista de prioridade para o controle."
		displayFolder: Previsão
		lineageTag: ced2ae64-d2cd-5d79-bfe9-ba21dd43dd49

	/// Intervalos validos por passagem reconstruida (cobertura_passagens da Gold, reagregada).
	measure Cobertura = DIVIDE ( SUM ( fato_qualidade[headways_validos] ), SUM ( fato_qualidade[passagens] ) )
		formatString: 0.0%
		displayFolder: Qualidade
		lineageTag: 7f527558-d89e-56a4-9027-4ff5f743a006

	/// Intervalos que atravessam uma parada do feed (descartados).
	measure 'Feed parado' = SUM ( fato_qualidade[headways_feed_parado] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: fa23642f-f3ee-5e02-a13b-6899f5553533

	/// Passagens de onibus por ponto reconstruidas.
	measure Passagens = SUM ( fato_qualidade[passagens] )
		formatString: #,0
		displayFolder: Qualidade
		lineageTag: 69cc03c1-3a27-59ed-9b7d-374dc6000113

	/// Intervalos descartados com o feed parado, sobre todos os intervalos reconstruidos.
	measure 'Feed parado %' = DIVIDE ( [Feed parado], SUM ( fato_qualidade[headways] ) )
		formatString: 0.0%
