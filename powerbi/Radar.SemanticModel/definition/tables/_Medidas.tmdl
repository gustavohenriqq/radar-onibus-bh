	/// Pontos de maior volume no mapa, os 10 piores numerados.
	measure 'HTML mapa' =
			VAR t0 = FILTER ( ADDCOLUMNS ( VALUES ( fato_paradas[stop_id] ), "@e", [Ponto · mapa espera],
			        "@v", [Ponto · volume] ), NOT ISBLANK ( [@e] ) )
			VAR t = TOPN ( 400, t0, [@v], DESC, fato_paradas[stop_id], ASC )
			VAR r = ADDCOLUMNS ( t, "@k", VAR _v = [@v] VAR _c = fato_paradas[stop_id] RETURN COUNTROWS ( FILTER ( t, [@v] > _v || ( [@v] = _v && fato_paradas[stop_id] < _c ) ) ) + 1 )
			VAR vmax = MAXX ( t, [@v] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 648 770' width='100%' height='100%'><text x='324' y='385' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 664 786' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<g transform='translate(626,18)'><path d='M0,-12 L7,6 L0,2 L-7,6 Z' fill='#C9D0E4'/><text y='22' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='middle'>N</text></g>"
			    & ( CONCATENATEX ( r, VAR px = 324.0 + ( [Ponto · longitude] - ( -43.9625 ) ) * 2427.164 VAR py = ( -19.768 - [Ponto · latitude] ) * 2582.090 RETURN "<circle cx='"
			    & ( FORMAT ( px, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( py, "0.0", "en-US" ) )
			    & "' r='"
			    & ( FORMAT ( 2.2 + 6 * SQRT ( DIVIDE ( [@v], vmax ) ), "0.0", "en-US" ) )
			    & "' fill='"
			    & ( SWITCH ( TRUE (), [@e] < 0.5, "#18203A", [@e] < 1.0, "#1F2B47", [@e] < 1.5, "#2E3550", [@e] < 2.0, "#4A3F4F", [@e] < 2.5, "#6E4A45", [@e] < 3.0, "#94563A", [@e] < 3.5, "#B9652F", [@e] < 4.5, "#DE7A2C", [@e] < 6.0, "#F59A33", "#FFC15A" ) )
			    & "' stroke='#0A0E1C' stroke-width='.6'/>", "", [@e], ASC ) )
			    & ( CONCATENATEX ( FILTER ( r, [@k] <= 10 ), VAR px = 324.0 + ( [Ponto · longitude] - ( -43.9625 ) ) * 2427.164 VAR py = ( -19.768 - [Ponto · latitude] ) * 2582.090 RETURN "<circle cx='"
			    & ( FORMAT ( px, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( py, "0.0", "en-US" ) )
			    & "' r='11' fill='#F4F6FB' stroke='#0A0E1C' stroke-width='2'/><text x='"
			    & ( FORMAT ( px, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( py + 4.5, "0.0", "en-US" ) )
			    & "' font-size='13' font-weight='700' fill='#0A0E1C' text-anchor='middle'>"
			    & ( FORMAT ( [@k], "0" ) )
			    & "</text>", "", [@k], DESC ) )
			    & "<text x='0' y='722' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>ESPERA EXTRA (MIN)</text><rect x='176' y='709' width='28' height='14' rx='3' fill='#18203A' stroke='#2A3456' stroke-width='.8'/><text x='176' y='738' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>0</text><rect x='206' y='709' width='28' height='14' rx='3' fill='#1F2B47' stroke='#2A3456' stroke-width='.8'/><rect x='236' y='709' width='28' height='14' rx='3' fill='#2E3550' stroke='#2A3456' stroke-width='.8'/><text x='236' y='738' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>1</text><rect x='266' y='709' width='28' height='14' rx='3' fill='#4A3F4F' stroke='#2A3456' stroke-width='.8'/><rect x='296' y='709' width='28' height='14' rx='3' fill='#6E4A45' stroke='#2A3456' stroke-width='.8'/><text x='296' y='738' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>2</text><rect x='326' y='709' width='28' height='14' rx='3' fill='#94563A' stroke='#2A3456' stroke-width='.8'/><rect x='356' y='709' width='28' height='14' rx='3' fill='#B9652F' stroke='#2A3456' stroke-width='.8'/><text x='356' y='738' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>3</text><rect x='386' y='709' width='28' height='14' rx='3' fill='#DE7A2C' stroke='#2A3456' stroke-width='.8'/><rect x='416' y='709' width='28' height='14' rx='3' fill='#F59A33' stroke='#2A3456' stroke-width='.8'/><text x='416' y='738' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>4,5</text><rect x='446' y='709' width='28' height='14' rx='3' fill='#FFC15A' stroke='#2A3456' stroke-width='.8'/><text x='446' y='738' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>6+</text><text x='0' y='762' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Os 400 de maior volume · tamanho: volume · nº: posição na tabela · cinza: demais pontos</text>"
			    & "</svg></div>" )
		displayFolder: HTML
