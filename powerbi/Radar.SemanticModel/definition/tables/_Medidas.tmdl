	/// Os 10 pontos de maior volume.
	measure 'HTML piores pontos' =
			VAR t0 = FILTER ( ADDCOLUMNS ( VALUES ( fato_paradas[stop_id] ), "@e", [Ponto · mapa espera],
			        "@v", [Ponto · volume] ), NOT ISBLANK ( [@e] ) )
			VAR t = TOPN ( 10, t0, [@v], DESC, fato_paradas[stop_id], ASC )
			VAR r = ADDCOLUMNS ( t, "@k", VAR _v = [@v] VAR _c = fato_paradas[stop_id] RETURN COUNTROWS ( FILTER ( t, [@v] > _v || ( [@v] = _v && fato_paradas[stop_id] < _c ) ) ) + 1 )
			VAR r10 = ADDCOLUMNS ( r, "@nome", CALCULATE ( MAX ( fato_paradas[stop_name] ) ), "@l", [Ponto · linhas],
			        "@r", [Ponto · espera regular], "@c", [Ponto · colados], "@p", [Ponto · parte] )
			VAR emax = MAXX ( r10, [@e] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 984 554' width='100%' height='100%'><text x='492' y='277' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1000 570' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>Nº</text><text x='44' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>CÓDIGO</text><text x='118' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>PONTO</text><text x='470' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>LINHAS</text><text x='568' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>REGULAR</text><text x='590' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>ESPERA EXTRA (MIN)</text><text x='880' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>COLADOS</text><text x='984' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.2'>% DO TOTAL</text>"
			    & ( CONCATENATEX ( r10, VAR y = 34 + ( [@k] - 1 ) * 52.00 RETURN "<circle cx='14' cy='"
			    & ( FORMAT ( y + 26.0, "0.0", "en-US" ) )
			    & "' r='14' fill='#F4F6FB'/><text x='14' y='"
			    & ( FORMAT ( y + 31.0, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#0A0E1C' text-anchor='middle'>"
			    & ( FORMAT ( [@k], "0" ) )
			    & "</text><text x='44' y='"
			    & ( FORMAT ( y + 32.0, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4'>"
			    & ( fato_paradas[stop_id] )
			    & "</text><text x='118' y='"
			    & ( FORMAT ( y + 32.0, "0.0", "en-US" ) )
			    & "' font-size='16' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( LEN ( [@nome] ) > 36, LEFT ( [@nome], 35 ) & "…", [@nome] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='470' y='"
			    & ( FORMAT ( y + 32.0, "0.0", "en-US" ) )
			    & "' font-size='16' fill='#C9D0E4' text-anchor='end'>"
			    & ( FORMAT ( [@l], "0" ) )
			    & "</text><text x='568' y='"
			    & ( FORMAT ( y + 32.0, "0.0", "en-US" ) )
			    & "' font-size='16' fill='#6AA8FF' text-anchor='end'>"
			    & ( FORMAT ( [@r], "0.00" ) )
			    & "</text><rect x='590' y='"
			    & ( FORMAT ( y + 19.0, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( [@e] / emax * 150, "0.0", "en-US" ) )
			    & "' height='14' rx='3' fill='#FFB347'/><text x='"
			    & ( FORMAT ( 598 + [@e] / emax * 150, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 32.0, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [@e], "0.00" ) )
			    & "</text><text x='880' y='"
