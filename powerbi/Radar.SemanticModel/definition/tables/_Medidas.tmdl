transform='translate(906.1,198) scale(1.15)'><rect width='27' height='17' rx='4' fill='#FFB347'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(567.6,198) scale(1.15)'><rect width='27' height='17' rx='4' fill='#FFB347'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(939.6,198) scale(1.15)'><rect width='27' height='17' rx='4' fill='#FFB347'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><animateTransform attributeName='transform' type='translate' from='0 0' to='372 0' dur='15s' repeatCount='indefinite'/></g></g><text x='668' y='262' font-size='15' font-weight='700' fill='#6AA8FF' text-anchor='start' letter-spacing='1.6'>INTERVALOS IGUAIS</text><clipPath id='pista262'><rect x='668' y='272' width='372' height='50' rx='12'/></clipPath><rect x='668' y='272' width='372' height='50' rx='12' fill='#0A0E1C' stroke='#2A3456'/><line x1='676' x2='1032' y1='297' y2='297' stroke='#2A3456' stroke-width='2' stroke-dasharray='14 12'/><rect x='899' y='272' width='3' height='50' fill='#F4F6FB' fill-opacity='.8'/><g clip-path='url(#pista262)'><g><g transform='translate(296.0,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(668.0,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(349.1,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(721.1,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(402.3,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(774.3,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(455.4,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(827.4,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(508.6,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(880.6,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(561.7,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(933.7,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(614.9,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><g transform='translate(986.9,282) scale(1.15)'><rect width='27' height='17' rx='4' fill='#6AA8FF'/><rect x='4' y='3.5' width='17' height='5' rx='1.5' fill='#0A0E1C' fill-opacity='.7'/><circle cx='6.5' cy='18' r='2.8' fill='#F4F6FB'/><circle cx='20.5' cy='18' r='2.8' fill='#F4F6FB'/></g><animateTransform attributeName='transform' type='translate' from='0 0' to='372 0' dur='15s' repeatCount='indefinite'/></g></g><text x='900.14' y='170' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>o ponto</text><text x='44' y='94' font-size='16' font-weight='600' fill='#FFB347' text-anchor='start' letter-spacing='1.2'>"
			    & ( [Recorte] )
			    & "</text><text x='34' y='238' font-size='150' font-weight='700' fill='#FFB347'>+"
			    & ( FORMAT ( ee, "0.00" ) )
			    & "<tspan font-size='48' dx='12'>min</tspan></text><text x='44' y='290' font-size='24' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>de espera <tspan fill='#FFB347'>a mais</tspan> em cada ida ao ponto,</text><text x='44' y='322' font-size='22' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>só porque os ônibus não passam em intervalos iguais</text><rect x='44' y='346' width='486' height='38' rx='19' fill-opacity='.14' fill='"
			    & ( corv )
			    & "' stroke='"
			    & ( corv )
			    & "'/><text x='66' y='371' font-size='18' font-weight='600' font-family='Segoe UI, sans-serif' fill='"
			    & ( corv )
			    & "'>"
			    & ( [Texto da variação] )
			    & "</text><text x='668' y='360' font-size='15' font-weight='700' fill='#C9D0E4' letter-spacing='1.6'>ESPERA MÉDIA NO PONTO: "
			    & ( FORMAT ( em, "0.0" ) )
			    & " MIN</text><rect x='668' y='370' width='"
			    & ( FORMAT ( wr, "0.0", "en-US" ) )
			    & "' height='26' rx='4' fill='#6AA8FF'/><rect x='"
			    & ( FORMAT ( 668 + wr, "0.0", "en-US" ) )
			    & "' y='370' width='"
			    & ( FORMAT ( 372 - wr, "0.0", "en-US" ) )
			    & "' height='26' rx='4' fill='#FFB347'/><text x='678' y='389' font-size='16' font-weight='700' fill='#0A0E1C'>"
			    & ( FORMAT ( er, "0.0" ) )
			    & " regular</text><text x='"
			    & ( FORMAT ( 668 + wr + (372 - wr) / 2, "0.0", "en-US" ) )
			    & "' y='389' font-size='16' font-weight='700' fill='#0A0E1C' text-anchor='middle'>+"
			    & ( FORMAT ( ee, "0.0" ) )
			    & "</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 4d0afdfa-3d62-5d65-a1ed-76a1fc996954

	/// Azulejos com o tamanho da medicao.
	measure 'HTML números' =
			IF ( ISBLANK ( [Intervalos] ), "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 584 288' width='100%' height='100%'><text x='292' y='144' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 304' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<rect x='0' y='0' width='284' height='136' rx='16' fill='#182038' stroke='#2A3456'/><rect x='0' y='18' width='4' height='100' rx='2' fill='#FF6B6B'/><text x='22' y='34' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>INTERVALOS COLADOS</text><text x='20' y='92' font-size='52' font-weight='700' fill='#FF6B6B'>"
			    & ( FORMAT ( [Colados], "0.0%" ) )
			    & "</text><text x='22' y='120' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>menos de 1/4 do intervalo médio</text><rect x='300' y='0' width='284' height='136' rx='16' fill='#182038' stroke='#2A3456'/><rect x='300' y='18' width='4' height='100' rx='2' fill='#42D392'/><text x='322' y='34' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>CORTE SEM COLAGEM</text><text x='320' y='92' font-size='52' font-weight='700' fill='#42D392'>"
			    & ( FORMAT ( [Corte sem colagem], "0%" ) )
			    & "</text><text x='322' y='120' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>da espera extra sumiria</text><rect x='0' y='152' width='284' height='136' rx='16' fill='#182038' stroke='#2A3456'/><rect x='0' y='170' width='4' height='100' rx='2' fill='#6AA8FF'/><text x='22' y='186' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>INTERVALOS MEDIDOS</text><text x='20' y='244' font-size='52' font-weight='700' fill='#6AA8FF'>"
			    & ( VAR v = [Intervalos] RETURN IF ( v >= 1000000, FORMAT ( v / 1000000, "0.0" ) & " mi", IF ( v >= 1000, FORMAT ( v / 1000, "0" ) & " mil", FORMAT ( v, "0" ) ) ) )
			    & "</text><text x='22' y='272' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>entre ônibus da mesma linha</text><rect x='300' y='152' width='284' height='136' rx='16' fill='#182038' stroke='#2A3456'/><rect x='300' y='170' width='4' height='100' rx='2' fill='#F4F6FB'/><text x='322' y='186' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>LINHAS MEDIDAS</text><text x='320' y='244' font-size='52' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [Linhas medidas], "0" ) )
			    & "</text><text x='322' y='272' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>com intervalo no recorte</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 07c13534-5a4a-5843-807a-e98c06c5105d

	/// Espera extra por dia, media do periodo e eventos numerados.
	measure 'HTML dia a dia' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@v", [Espera extra],
			        "@e", CALCULATE ( MAX ( dim_data[evento] ) ) ), NOT ISBLANK ( [@v] ) )
			VAR d0 = MINX ( t, dim_data[data] )
			VAR d1 = MAXX ( t, dim_data[data] )
			VAR n = INT ( d1 - d0 ) + 1
			VAR med = [Espera extra]
			VAR topo = MAX ( 2, CEILING ( MAXX ( t, [@v] ) * 1.3, 1 ) )
			VAR passo = IF ( topo <= 5, 1, 2 )
			VAR bw = 574 / n
			VAR ym = 292 - med / topo * 262
			VAR evd = FILTER ( eventos, eventos[evento] <> "" && eventos[data] >= d0 && eventos[data] <= d1 )
			VAR ev = ADDCOLUMNS ( SUMMARIZE ( evd, eventos[evento], eventos[evento_l1], eventos[evento_l2],
			        eventos[evento_l3], eventos[evento_n] ),
			        "@d", VAR e = eventos[evento] RETURN MINX ( FILTER ( evd, eventos[evento] = e ), eventos[data] ) )
			VAR ev2 = ADDCOLUMNS ( ev, "@i", RANKX ( ev, [@d], , ASC, DENSE ) )
			VAR ev3 = ADDCOLUMNS ( ev2, "@y", VAR dd = [@d]
			        RETURN 51 + SUMX ( FILTER ( ev2, [@d] < dd ), eventos[evento_n] * 19 + 12 ) )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1048 354' width='100%' height='100%'><text x='524' y='177' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1064 370' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( GENERATESERIES ( passo, topo, passo ),
			        VAR yg = 292 - [Value] / topo * 262
			        RETURN "<line x1='50' x2='624' y1='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( yg, "0.0", "en-US" ) )
			    & "' stroke='#2A3456' stroke-dasharray='4 6'/><text x='40' y='"
			    & ( FORMAT ( yg + 5, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( [Value], "0" ) )
			    & "</text>", "" ) )
			    & "<line x1='50' x2='624' y1='292' y2='292' stroke='#9AA3C2'/><text x='40' y='297' font-size='15' fill='#9AA3C2' text-anchor='end'>0</text>"
			    & ( CONCATENATEX ( t,
			        VAR i = INT ( dim_data[data] - d0 )
			        VAR x = 50 + i * bw + bw * 0.14
			        VAR hb = DIVIDE ( [@v], topo ) * 262
			        VAR e = [@e]
			        VAR tem = e <> ""
			        VAR k = MAXX ( FILTER ( ev2, eventos[evento] = e ), [@i] )
			        VAR primeiro = tem && dim_data[data] = MAXX ( FILTER ( ev2, eventos[evento] = e ), [@d] )
			        VAR cy = IF ( MOD ( k, 2 ) = 1, 44, 74 )
			        RETURN "<rect x='"
			    & ( FORMAT ( x, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 292 - hb, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( bw * 0.72, "0.0", "en-US" ) )
			    & "' height='"
			    & ( FORMAT ( hb, "0.0", "en-US" ) )
			    & "' rx='2' fill='"
			    & ( IF ( tem, "#F4F6FB", "#FFB347" ) )
			    & "'/>"
			    & ( IF ( primeiro, "<line x1='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' y1='"
			    & ( FORMAT ( 292 - hb - 3, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( cy + 12, "0.0", "en-US" ) )
			    & "' stroke='#F4F6FB' stroke-opacity='.45' stroke-dasharray='2 3'/><circle cx='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( cy, "0.0", "en-US" ) )
			    & "' r='12' fill='#F4F6FB'/><text x='"
			    & ( FORMAT ( x + bw * 0.36, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( cy + 5, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#0A0E1C' text-anchor='middle'>"
			    & ( FORMAT ( k, "0" ) )
			    & "</text>" ) ), "", dim_data[data], ASC ) )
			    & "<line x1='50' x2='624' y1='"
			    & ( FORMAT ( ym, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( ym, "0.0", "en-US" ) )
			    & "' stroke='#6AA8FF' stroke-width='2' stroke-dasharray='8 6'/><line x1='50' x2='80' y1='10' y2='10' stroke='#6AA8FF' stroke-width='2' stroke-dasharray='8 6'/><text x='90' y='16' font-size='16' font-weight='600' fill='#6AA8FF'>média do período: "
			    & ( FORMAT ( med, "0.00" ) )
			    & " min</text>"
			    & ( CONCATENATEX ( FILTER ( t, n <= 10 || WEEKDAY ( dim_data[data], 2 ) = 1 ),
			        VAR xd = 50 + INT ( dim_data[data] - d0 ) * bw + bw / 2
			        RETURN "<text x='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' y='320' font-size='16' fill='#C9D0E4' text-anchor='middle'>"
			    & ( FORMAT ( dim_data[data], "dd/mm" ) )
			    & "</text><line x1='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( xd, "0.0", "en-US" ) )
			    & "' y1='292' y2='299' stroke='#9AA3C2'/>", "" ) )
			    & "<text x='50' y='350' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>"
			    & ( IF ( n <= 10, "dias do período", "datas: as segundas-feiras" ) )
			    & "</text><text x='660' y='20' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.5'>EVENTOS NA CIDADE</text>"
			    & ( IF ( COUNTROWS ( ev2 ) = 0,
			        "<text x='660' y='60' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>Nenhum evento anotado no período</text>",
			        CONCATENATEX ( FILTER ( ev3, [@y] + ( eventos[evento_n] - 1 ) * 19 <= 348 ),
			            VAR y = [@y]
			            RETURN "<circle cx='673' cy='"
			    & ( FORMAT ( y - 6, "0.0", "en-US" ) )
			    & "' r='13' fill='#F4F6FB'/><text x='673' y='"
			    & ( FORMAT ( y - 1, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#0A0E1C' text-anchor='middle'>"
			    & ( FORMAT ( [@i], "0" ) )
			    & "</text><text x='696' y='"
			    & ( FORMAT ( y, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#F4F6FB'>"
			    & ( FORMAT ( [@d], "dd/mm" ) )
			    & "</text><text x='748' y='"
			    & ( FORMAT ( y, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( eventos[evento_l1], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='748' y='"
			    & ( FORMAT ( y + 19, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( eventos[evento_l2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><text x='748' y='"
			    & ( FORMAT ( y + 38, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( eventos[evento_l3], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text>", "", [@d], ASC ) ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 5a34c9b6-e697-5282-a106-22fb4043a91a

	/// Espera regular e extra por faixa horaria.
	measure 'HTML faixa' =
			VAR t = FILTER ( ADDCOLUMNS ( ALL ( dim_faixa[faixa], dim_faixa[horas], dim_faixa[ordem] ),
			        "@r", [Espera regular], "@x", [Espera extra] ), NOT ISBLANK ( [@x] ) )
			VAR topo = MAXX ( t, [@r] + [@x] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 584 354' width='100%' height='100%'><text x='292' y='177' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 600 370' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & ( CONCATENATEX ( t,
			        VAR y = ( dim_faixa[ordem] - 1 ) * 59
			        VAR wr = DIVIDE ( [@r], topo ) * 268
			        VAR wx = DIVIDE ( [@x], topo ) * 268
			        RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 22, "0.0", "en-US" ) )
			    & "' font-size='18' font-weight='600' fill='#F4F6FB' font-family='Segoe UI, sans-serif'>"
			    & ( dim_faixa[faixa] )
			    & "</text><text x='0' y='"
			    & ( FORMAT ( y + 43, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( dim_faixa[horas] )
			    & "</text><rect x='170' y='"
			    & ( FORMAT ( y + 12, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( wr, "0.0", "en-US" ) )
			    & "' height='26' rx='4' fill='#6AA8FF'/><rect x='"
			    & ( FORMAT ( 170 + wr, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 12, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( wx, "0.0", "en-US" ) )
			    & "' height='26' rx='4' fill='#FFB347'/><text x='584' y='"
			    & ( FORMAT ( y + 24, "0.0", "en-US" ) )
			    & "' font-size='21' font-weight='700' fill='#FFB347' text-anchor='end'>+"
			    & ( FORMAT ( [@x], "0.00" ) )
			    & "</text><text x='584' y='"
			    & ( FORMAT ( y + 44, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4' text-anchor='end' font-family='Segoe UI, sans-serif'>de "
			    & ( FORMAT ( [@r] + [@x], "0.0" ) )
			    & " min</text>", "", dim_faixa[ordem], ASC ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 775d75c8-a587-50dd-98d6-112afe51129f

	/// As 30 linhas de maior volume x faixa horaria.
	measure 'HTML calor linha faixa' =
			VAR t = TOPN ( 30, FILTER ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@v", [Volume], "@e", [Espera extra] ),
			        NOT ISBLANK ( [@v] ) ), [@v], DESC, dim_linha[route_id], ASC )
			VAR r = ADDCOLUMNS ( t, "@k", VAR _v = [@e] VAR _c = dim_linha[route_id] RETURN COUNTROWS ( FILTER ( t, [@e] > _v || ( [@e] = _v && dim_linha[route_id] < _c ) ) ) + 1 )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 948 770' width='100%' height='100%'><text x='474' y='385' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 964 786' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='167' y='18' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Madrugada</text><text x='167' y='37' font-size='13' font-weight='400' fill='#9AA3C2' text-anchor='middle'>0h às 5h</text><text x='309' y='18' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Início da manhã</text><text x='309' y='37' font-size='13' font-weight='400' fill='#9AA3C2' text-anchor='middle'>5h às 6h</text><text x='451' y='18' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Pico da manhã</text><text x='451' y='37' font-size='13' font-weight='400' fill='#9AA3C2' text-anchor='middle'>6h às 9h</text><text x='593' y='18' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Entre picos</text><text x='593' y='37' font-size='13' font-weight='400' fill='#9AA3C2' text-anchor='middle'>9h às 16h</text><text x='735' y='18' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Pico da tarde</text><text x='735' y='37' font-size='13' font-weight='400' fill='#9AA3C2' text-anchor='middle'>16h às 20h</text><text x='877' y='18' font-size='14' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Noite</text><text x='877' y='37' font-size='13' font-weight='400' fill='#9AA3C2' text-anchor='middle'>20h às 24h</text>"
			    & ( CONCATENATEX ( r, VAR y = 50 + ( [@k] - 1 ) * 22.27 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 16.1, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='700' fill='#F4F6FB'>"
			    & ( dim_linha[route_id] )
			    & "</text>"
			    & ( CONCATENATEX ( ALL ( dim_faixa[ordem] ), VAR v = [Espera extra] RETURN IF ( ISBLANK ( v ), "", "<rect x='"
			    & ( FORMAT ( 96 + ( dim_faixa[ordem] - 1 ) * 142.00 + 2, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 2, "0.0", "en-US" ) )
			    & "' width='138.0' height='18.3' rx='4' fill='"
			    & ( SWITCH ( TRUE (), v < 0.5, "#18203A", v < 1.0, "#1F2B47", v < 1.5, "#2E3550", v < 2.0, "#4A3F4F", v < 2.5, "#6E4A45", v < 3.0, "#94563A", v < 3.5, "#B9652F", v < 4.5, "#DE7A2C", v < 6.0, "#F59A33", "#FFC15A" ) )
			    & "'/><text x='"
			    & ( FORMAT ( 96 + ( dim_faixa[ordem] - 1 ) * 142.00 + 71.0, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 16.2, "0.0", "en-US" ) )
			    & "' font-size='14' font-weight='600' text-anchor='middle' fill='"
			    & ( IF ( v < 3.0, "#F4F6FB", "#0A0E1C" ) )
			    & "'>"
			    & ( FORMAT ( v, "0.0" ) )
			    & "</text>" ), "" ) ), "" ) )
			    & "<text x='0' y='748' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.2'>ESPERA EXTRA (MIN)</text><rect x='176' y='735' width='30' height='14' rx='3' fill='#18203A' stroke='#2A3456' stroke-width='.8'/><text x='176' y='764' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>0</text><rect x='208' y='735' width='30' height='14' rx='3' fill='#1F2B47' stroke='#2A3456' stroke-width='.8'/><rect x='240' y='735' width='30' height='14' rx='3' fill='#2E3550' stroke='#2A3456' stroke-width='.8'/><text x='240' y='764' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>1</text><rect x='272' y='735' width='30' height='14' rx='3' fill='#4A3F4F' stroke='#2A3456' stroke-width='.8'/><rect x='304' y='735' width='30' height='14' rx='3' fill='#6E4A45' stroke='#2A3456' stroke-width='.8'/><text x='304' y='764' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>2</text><rect x='336' y='735' width='30' height='14' rx='3' fill='#94563A' stroke='#2A3456' stroke-width='.8'/><rect x='368' y='735' width='30' height='14' rx='3' fill='#B9652F' stroke='#2A3456' stroke-width='.8'/><text x='368' y='764' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>3</text><rect x='400' y='735' width='30' height='14' rx='3' fill='#DE7A2C' stroke='#2A3456' stroke-width='.8'/><rect x='432' y='735' width='30' height='14' rx='3' fill='#F59A33' stroke='#2A3456' stroke-width='.8'/><text x='432' y='764' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>4,5</text><rect x='464' y='735' width='30' height='14' rx='3' fill='#FFC15A' stroke='#2A3456' stroke-width='.8'/><text x='464' y='764' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>6+</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 326d3742-c80a-55c6-a597-1e9ae6b613bf

	/// Espera extra dia a dia em semanas, com eventos.
	measure 'HTML calendário' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@v", [Espera extra],
			        "@e", CALCULATE ( MAX ( dim_data[evento] ) ), "@s", CALCULATE ( MAX ( dim_data[semana] ) ),
			        "@w", WEEKDAY ( dim_data[data], 2 ) ), NOT ISBLANK ( [@v] ) )
			VAR s0 = MINX ( t, [@s] )
			VAR nw = INT ( ( MAXX ( t, [@s] ) - s0 ) / 7 ) + 1
			VAR rh = MIN ( 60, 302 / nw )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 684 382' width='100%' height='100%'><text x='342' y='191' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 700 398' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='20' font-size='12' font-weight='700' fill='#9AA3C2' text-anchor='start' letter-spacing='1.2'>SEMANA</text><text x='121' y='20' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Seg</text><text x='208' y='20' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Ter</text><text x='294' y='20' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Qua</text><text x='381' y='20' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Qui</text><text x='468' y='20' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Sex</text><text x='554' y='20' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Sáb</text><text x='641' y='20' font-size='15' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Dom</text>"
			    & ( CONCATENATEX ( DISTINCT ( SELECTCOLUMNS ( t, "@s", [@s] ) ), VAR y = 30 + INT ( ( [@s] - s0 ) / 7 ) * rh RETURN "<text x='0' y='"
			    & ( FORMAT ( y + rh / 2 + 6, "0.0", "en-US" ) )
			    & "' font-size='15' fill='#C9D0E4'>"
			    & ( FORMAT ( [@s], "dd/mm" ) )
			    & "</text>", "" ) )
			    & ( CONCATENATEX ( t, VAR x = 78 + ( [@w] - 1 ) * 86.57 VAR y = 30 + INT ( ( [@s] - s0 ) / 7 ) * rh VAR v = [@v] RETURN "<g>"
			    & ( IF ( [@e] <> "", "<title>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [@e], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</title>" ) )
			    & "<rect x='"
			    & ( FORMAT ( x + 2, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 2, "0.0", "en-US" ) )
			    & "' width='82.6' height='"
			    & ( FORMAT ( rh - 4, "0.0", "en-US" ) )
			    & "' rx='5' fill='"
			    & ( SWITCH ( TRUE (), v < 0.5, "#18203A", v < 1.0, "#1F2B47", v < 1.5, "#2E3550", v < 2.0, "#4A3F4F", v < 2.5, "#6E4A45", v < 3.0, "#94563A", v < 3.5, "#B9652F", v < 4.5, "#DE7A2C", v < 6.0, "#F59A33", "#FFC15A" ) )
			    & "'/><text x='"
			    & ( FORMAT ( x + 43.3, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + rh / 2 + 7, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' text-anchor='middle' fill='"
			    & ( IF ( v < 3.0, "#F4F6FB", "#0A0E1C" ) )
			    & "'>"
			    & ( FORMAT ( v, "0.0" ) )
			    & "</text><text x='"
			    & ( FORMAT ( x + 8, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 16, "0.0", "en-US" ) )
			    & "' font-size='12' fill-opacity='.7' fill='"
			    & ( IF ( v < 3.0, "#F4F6FB", "#0A0E1C" ) )
			    & "'>"
			    & ( FORMAT ( dim_data[data], "dd" ) )
			    & "</text>"
			    & ( IF ( [@e] <> "", "<circle cx='"
			    & ( FORMAT ( x + 74.6, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( y + 12, "0.0", "en-US" ) )
			    & "' r='5' fill='#F4F6FB' stroke='#0A0E1C' stroke-width='1.5'/>" ) )
			    & "</g>", "" ) )
			    & "<rect x='0' y='347' width='26' height='14' rx='3' fill='#18203A' stroke='#2A3456' stroke-width='.8'/><text x='0' y='376' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>0</text><rect x='28' y='347' width='26' height='14' rx='3' fill='#1F2B47' stroke='#2A3456' stroke-width='.8'/><rect x='56' y='347' width='26' height='14' rx='3' fill='#2E3550' stroke='#2A3456' stroke-width='.8'/><text x='56' y='376' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>1</text><rect x='84' y='347' width='26' height='14' rx='3' fill='#4A3F4F' stroke='#2A3456' stroke-width='.8'/><rect x='112' y='347' width='26' height='14' rx='3' fill='#6E4A45' stroke='#2A3456' stroke-width='.8'/><text x='112' y='376' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>2</text><rect x='140' y='347' width='26' height='14' rx='3' fill='#94563A' stroke='#2A3456' stroke-width='.8'/><rect x='168' y='347' width='26' height='14' rx='3' fill='#B9652F' stroke='#2A3456' stroke-width='.8'/><text x='168' y='376' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>3</text><rect x='196' y='347' width='26' height='14' rx='3' fill='#DE7A2C' stroke='#2A3456' stroke-width='.8'/><rect x='224' y='347' width='26' height='14' rx='3' fill='#F59A33' stroke='#2A3456' stroke-width='.8'/><text x='224' y='376' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>4,5</text><rect x='252' y='347' width='26' height='14' rx='3' fill='#FFC15A' stroke='#2A3456' stroke-width='.8'/><text x='252' y='376' font-size='13' font-weight='600' fill='#9AA3C2' text-anchor='start'>6+</text><circle cx='377' cy='359' r='6' fill='#F4F6FB' stroke='#0A0E1C'/><text x='391' y='364' font-size='14' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>dia com evento na cidade (passe o mouse)</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 3077505b-6539-52dd-a5e8-88078b72067d

	/// Espera extra por dia da semana e faixa horaria.
	measure 'HTML semana faixa' =
			IF ( ISBLANK ( [Espera extra] ), "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 684 260' width='100%' height='100%'><text x='342' y='130' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 700 276' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='108' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Madrugada</text><text x='108' y='35' font-size='12' font-weight='400' fill='#9AA3C2' text-anchor='middle'>0h às 5h</text><text x='213' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Início da manhã</text><text x='213' y='35' font-size='12' font-weight='400' fill='#9AA3C2' text-anchor='middle'>5h às 6h</text><text x='318' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Pico da manhã</text><text x='318' y='35' font-size='12' font-weight='400' fill='#9AA3C2' text-anchor='middle'>6h às 9h</text><text x='422' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Entre picos</text><text x='422' y='35' font-size='12' font-weight='400' fill='#9AA3C2' text-anchor='middle'>9h às 16h</text><text x='527' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Pico da tarde</text><text x='527' y='35' font-size='12' font-weight='400' fill='#9AA3C2' text-anchor='middle'>16h às 20h</text><text x='632' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='middle'>Noite</text><text x='632' y='35' font-size='12' font-weight='400' fill='#9AA3C2' text-anchor='middle'>20h às 24h</text>"
			    & ( CONCATENATEX ( ALL ( dim_data[dia_semana_ordem], dim_data[dia_semana] ),
			        VAR y = 44 + ( dim_data[dia_semana_ordem] - 1 ) * 30.86 RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 21.4, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#C9D0E4'>"
			    & ( dim_data[dia_semana] )
			    & "</text>"
			    & ( CONCATENATEX ( ALL ( dim_faixa[ordem] ), VAR v = [Espera extra] RETURN IF ( ISBLANK ( v ), "", "<rect x='"
			    & ( FORMAT ( 56 + ( dim_faixa[ordem] - 1 ) * 104.67 + 2, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 2, "0.0", "en-US" ) )
			    & "' width='100.7' height='26.9' rx='4' fill='"
			    & ( SWITCH ( TRUE (), v < 0.5, "#18203A", v < 1.0, "#1F2B47", v < 1.5, "#2E3550", v < 2.0, "#4A3F4F", v < 2.5, "#6E4A45", v < 3.0, "#94563A", v < 3.5, "#B9652F", v < 4.5, "#DE7A2C", v < 6.0, "#F59A33", "#FFC15A" ) )
			    & "'/><text x='"
			    & ( FORMAT ( 56 + ( dim_faixa[ordem] - 1 ) * 104.67 + 52.3, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( y + 20.8, "0.0", "en-US" ) )
			    & "' font-size='15' font-weight='600' text-anchor='middle' fill='"
			    & ( IF ( v < 3.0, "#F4F6FB", "#0A0E1C" ) )
			    & "'>"
			    & ( FORMAT ( v, "0.0" ) )
			    & "</text>" ), "" ) ), "" ) )
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 224820a1-32b1-520c-bd2b-c9b9e2aeabd8

	/// Linhas que somam 80% e a curva acumulada.
	measure 'HTML concentração' =
			VAR n80 = [Linhas para 80%]
			VAR lr = [Linhas na rede]
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@v", [Volume], "@p", [Parte da espera extra],
			        "@a", [Parte acumulada] ), NOT ISBLANK ( [@v] ) )
			VAR r = FILTER ( ADDCOLUMNS ( t, "@k", VAR _v = [@v] VAR _c = dim_linha[route_id] RETURN COUNTROWS ( FILTER ( t, [@v] > _v || ( [@v] = _v && dim_linha[route_id] < _c ) ) ) + 1 ), [@k] <= n80 + 15 )
			VAR bw = 1236 / MAX ( 1, COUNTROWS ( r ) )
			VAR pmax = MAXX ( r, [@p] )
			RETURN
			    IF ( COUNTROWS ( r ) = 0 || ISBLANK ( n80 ), "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1700 282' width='100%' height='100%'><text x='850' y='141' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 1716 298' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='122' font-size='120' font-weight='700' fill='#FFB347'>"
			    & ( FORMAT ( n80, "0" ) )
			    & "</text><text x='4' y='164' font-size='24' font-weight='700' fill='#F4F6FB' text-anchor='start' font-family='Segoe UI, sans-serif'>linhas somam 80%</text><text x='4' y='194' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>da espera extra da rede</text><text x='4' y='228' font-size='17' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>são "
			    & ( FORMAT ( [Linhas para 80% %], "0%" ) )
			    & " das "
			    & ( FORMAT ( lr, "0" ) )
			    & " linhas medidas</text><rect x='400' y='4' width='15' height='15' rx='3' fill='#FFB347'/><text x='423' y='16' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>parte de cada linha na espera extra da rede</text><rect x='775' y='4' width='15' height='15' rx='3' fill='#9AA3C2'/><text x='798' y='16' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>as 15 seguintes</text><line x1='940' x2='968' y1='11' y2='11' stroke='#F4F6FB' stroke-width='2.5'/><text x='976' y='16' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='start' font-family='Segoe UI, sans-serif'>soma acumulada (eixo à direita)</text><line x1='400' x2='1636' y1='141.0' y2='141.0' stroke='#2A3456' stroke-opacity='1' stroke-dasharray='6 6'/><text x='1646' y='146' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start'>50%</text><line x1='400' x2='1636' y1='84.0' y2='84.0' stroke='#F4F6FB' stroke-opacity='0.55' stroke-dasharray='6 6'/><text x='1646' y='89' font-size='15' font-weight='700' fill='#F4F6FB' text-anchor='start'>80%</text><line x1='400' x2='1636' y1='46.0' y2='46.0' stroke='#2A3456' stroke-opacity='1' stroke-dasharray='6 6'/><text x='1646' y='51' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start'>100%</text><line x1='400' x2='1636' y1='236' y2='236' stroke='#9AA3C2'/><text x='1646' y='241' font-size='15' font-weight='400' fill='#9AA3C2' text-anchor='start'>0%</text>"
			    & ( CONCATENATEX ( r, VAR x = 400 + ( [@k] - 1 ) * bw VAR hb = [@p] / pmax * 114 RETURN "<rect x='"
			    & ( FORMAT ( x + bw * 0.1, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( 236 - hb, "0.0", "en-US" ) )
			    & "' width='"
			    & ( FORMAT ( bw * 0.8, "0.0", "en-US" ) )
			    & "' height='"
			    & ( FORMAT ( hb, "0.0", "en-US" ) )
			    & "' fill='"
			    & ( IF ( [@k] <= n80, "#FFB347", "#9AA3C2" ) )
			    & "' fill-opacity='"
			    & ( IF ( [@k] <= n80, ".9", ".45" ) )
			    & "'/>", "" ) )
			    & "<polyline points='"
			    & ( CONCATENATEX ( r, FORMAT ( 400 + ( [@k] - 0.5 ) * bw, "0.0", "en-US" ) & "," & FORMAT ( 236 - [@a] * 190, "0.0", "en-US" ), " ", [@k], ASC ) )
			    & "' fill='none' stroke='#F4F6FB' stroke-width='2.5' stroke-linejoin='round'/><line x1='"
			    & ( FORMAT ( 400 + n80 * bw, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( 400 + n80 * bw, "0.0", "en-US" ) )
			    & "' y1='42' y2='236' stroke='#FFB347' stroke-width='2' stroke-dasharray='6 5'/><text x='"
			    & ( FORMAT ( 400 + n80 * bw - 8, "0.0", "en-US" ) )
			    & "' y='60' font-size='15' font-weight='700' fill='#FFB347' text-anchor='end'>até aqui, 80%</text>"
			    & ( CONCATENATEX ( FILTER ( r, [@k] = 1 || MOD ( [@k], 25 ) = 0 ), VAR x = 400 + ( [@k] - 1 ) * bw RETURN "<text x='"
			    & ( FORMAT ( x + bw / 2, "0.0", "en-US" ) )
			    & "' y='258' font-size='14' fill='#9AA3C2' text-anchor='middle'>"
			    & ( FORMAT ( [@k], "0" ) )
			    & "ª</text>", "" ) )
			    & "<text x='400' y='280' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='start' font-family='Segoe UI, sans-serif'>linhas na ordem do volume de espera extra (espera extra × horas de serviço) · a maior tem "
			    & ( FORMAT ( pmax, "0.0%" ) )
			    & " da rede</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 502256bf-cb8e-5516-b138-6824cc36202d

	/// Colados contra espera extra por linha.
	measure 'HTML quadrantes' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@x", [Colados], "@y", [Espera extra],
			        "@h", [Horas de serviço], "@v", [Volume] ), NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] ) )
			VAR rx = [Colados da rede]
			VAR ry = [Espera extra da rede]
			VAR mx = MAX ( rx * 2, PERCENTILEX.INC ( t, [@x], 0.98 ) * 1.1 )
			VAR my = MAX ( ry * 2, PERCENTILEX.INC ( t, [@y], 0.98 ) * 1.1 )
			VAR mh = MAXX ( t, [@h] )
			VAR xr = 70 + rx / mx * 724
			VAR yr = 284 - ry / my * 254
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 808 334' width='100%' height='100%'><text x='404' y='167' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 824 350' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<line x1='70' x2='794' y1='284' y2='284' stroke='#9AA3C2'/><line x1='70' x2='70' y1='30' y2='284' stroke='#9AA3C2'/><line x1='"
			    & ( FORMAT ( xr, "0.0", "en-US" ) )
			    & "' x2='"
			    & ( FORMAT ( xr, "0.0", "en-US" ) )
			    & "' y1='30' y2='284' stroke='#C9D0E4' stroke-opacity='.6' stroke-dasharray='6 5'/><line x1='70' x2='794' y1='"
			    & ( FORMAT ( yr, "0.0", "en-US" ) )
			    & "' y2='"
			    & ( FORMAT ( yr, "0.0", "en-US" ) )
			    & "' stroke='#C9D0E4' stroke-opacity='.6' stroke-dasharray='6 5'/>"
			    & ( CONCATENATEX ( t, VAR px = 70 + MIN ( [@x] / mx, 1 ) * 724 VAR py = 284 - MIN ( [@y] / my, 1 ) * 254 VAR rr = 2.5 + 9 * SQRT ( DIVIDE ( [@h], mh ) ) RETURN "<circle cx='"
			    & ( FORMAT ( px, "0.0", "en-US" ) )
			    & "' cy='"
			    & ( FORMAT ( py, "0.0", "en-US" ) )
			    & "' r='"
			    & ( FORMAT ( rr, "0.0", "en-US" ) )
			    & "' fill='"
			    & ( SWITCH ( TRUE (), [@x] >= rx && [@y] >= ry, "#FF6B6B", [@y] >= ry, "#FFB347", [@x] >= rx, "#6AA8FF", "#9AA3C2" ) )
			    & "' fill-opacity='.72' stroke='#0A0E1C' stroke-width='.8'/>", "", [@h], DESC ) )
			    & ( CONCATENATEX ( TOPN ( 5, t, [@v], DESC, dim_linha[route_id], ASC ), VAR px = 70 + MIN ( [@x] / mx, 1 ) * 724 VAR py = 284 - MIN ( [@y] / my, 1 ) * 254 VAR rr = 2.5 + 9 * SQRT ( DIVIDE ( [@h], mh ) ) RETURN "<text x='"
			    & ( FORMAT ( px + rr + 4, "0.0", "en-US" ) )
			    & "' y='"
			    & ( FORMAT ( py + 5, "0.0", "en-US" ) )
			    & "' font-size='14' font-weight='700' fill='#F4F6FB' stroke='#0A0E1C' stroke-width='3' paint-order='stroke'>"
			    & ( dim_linha[route_id] )
			    & "</text>", "" ) )
			    & "<text stroke='#0A0E1C' stroke-width='4' paint-order='stroke' x='788' y='46' font-size='14' font-weight='700' fill='#FF6B6B' text-anchor='end'>muito colado e muita espera</text><text stroke='#0A0E1C' stroke-width='4' paint-order='stroke' x='80' y='46' font-size='14' font-weight='700' fill='#FFB347' text-anchor='start'>espera alta, pouco colado</text><text stroke='#0A0E1C' stroke-width='4' paint-order='stroke' x='788' y='274' font-size='14' font-weight='700' fill='#6AA8FF' text-anchor='end'>muito colado, espera baixa</text><text stroke='#0A0E1C' stroke-width='4' paint-order='stroke' x='80' y='274' font-size='14' font-weight='700' fill='#9AA3C2' text-anchor='start'>abaixo da rede nas duas</text><text x='70' y='304' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='middle'>0%</text><text x='"
			    & ( FORMAT ( xr, "0.0", "en-US" ) )
			    & "' y='304' font-size='14' fill='#C9D0E4' text-anchor='middle'>rede "
			    & ( FORMAT ( rx, "0.0%" ) )
			    & "</text><text x='794' y='304' font-size='14' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( mx, "0%" ) )
			    & "</text><text x='432' y='332' font-size='15' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>intervalos colados</text><text x='62' y='289' font-size='14' font-weight='400' fill='#9AA3C2' text-anchor='end'>0</text><text x='62' y='"
			    & ( FORMAT ( yr + 5, "0.0", "en-US" ) )
			    & "' font-size='14' fill='#C9D0E4' text-anchor='end'>"
			    & ( FORMAT ( ry, "0.0" ) )
			    & "</text><text x='62' y='35' font-size='14' fill='#9AA3C2' text-anchor='end'>"
			    & ( FORMAT ( my, "0" ) )
			    & "</text><text transform='translate(14,157) rotate(-90)' font-size='15' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>espera extra (min)</text>"
			    & "</svg></div>" )
		displayFolder: HTML
		lineageTag: 4dfaf3f9-1401-51ba-8cdc-1ecbd549722d

	/// As 7 linhas de maior volume, com tendencia.
	measure 'HTML ranking' =
			VAR dd = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@x", [Espera extra] ), NOT ISBLANK ( [@x] ) )
			VAR d0 = MINX ( dd, dim_data[data] )
			VAR nd = MAX ( 1, INT ( MAXX ( dd, dim_data[data] ) - d0 ) )
			VAR t = TOPN ( 7, FILTER ( ADDCOLUMNS ( VALUES ( dim_linha[route_id] ), "@v", [Volume], "@pos", [Posição],
			        "@p", [Parte da espera extra], "@e", [Espera extra], "@c", [Colados],
			        "@nome", CALCULATE ( MAX ( dim_linha[route_long_name] ) ) ), NOT ISBLANK ( [@v] ) ),
			        [@v], DESC, dim_linha[route_id], ASC )
			VAR r = ADDCOLUMNS ( t, "@k", VAR _v = [@v] VAR _c = dim_linha[route_id] RETURN COUNTROWS ( FILTER ( t, [@v] > _v || ( [@v] = _v && dim_linha[route_id] < _c ) ) ) + 1 )
			VAR emax = MAXX ( t, [@e] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "<div style='width:100%;height:100%;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 824 334' width='100%' height='100%'><text x='412' y='167' font-size='20' font-weight='400' fill='#C9D0E4' text-anchor='middle' font-family='Segoe UI, sans-serif'>Sem dado no recorte escolhido</text></svg></div>",
			    "<div style='width:100%;height:100%;overflow:hidden;background:#111729'><svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 840 350' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Bahnschrift, DIN Alternate, Segoe UI, sans-serif'>"
			    & "<text x='0' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start'>#</text><text x='46' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.3'>LINHA</text><text x='300' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.3'>DIA A DIA</text><text x='540' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.3'>% DA REDE</text><text x='560' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='start' letter-spacing='1.3'>ESPERA EXTRA (MIN)</text><text x='824' y='16' font-size='13' font-weight='700' fill='#C9D0E4' text-anchor='end' letter-spacing='1.3'>COLADOS</text>"
			    & ( CONCATENATEX ( r, VAR y = 30 + ( [@k] - 1 ) * 43.43
			        VAR sd = FILTER ( ADDCOLUMNS ( VALUES ( dim_data[data] ), "@d", [Espera extra] ), NOT ISBLANK ( [@d] ) )
			        VAR st = MAX ( 6, MAXX ( sd, [@d] ) )
			        RETURN "<text x='0' y='"
			    & ( FORMAT ( y + 25, "0.0", "en-US" ) )
			    & "' font-size='16' font-weight='700' fill='#FFB347'>"
			    & ( FORMAT ( [@pos], "0" ) )
			    & "ª</text><text x='46' y='"
			    & ( FORMAT ( y + 25, "0.0", "en-US" ) )
			    & "' font-size='17' font-weight='700' fill='#F4F6FB'>"
			    & ( dim_linha[route_id] )
			    & "</text><text x='112' y='"
			    & ( FORMAT ( y + 25, "0.0", "en-US" ) )
			    & "' font-size='14' fill='#C9D0E4' font-family='Segoe UI, sans-serif'>"
			    & ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( LEN ( [@nome] ) > 24, LEFT ( [@nome], 23 ) & "…", [@nome] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) )
			    & "</text><polyline points='"
