# Copie para .env e preencha. O .env nunca vai para o Git.

# Feed vehicle-positions da PBH. Copie a URL completa, com a chave, do recurso
# "vehicle-positions" em https://dados.pbh.gov.br/dataset/gtfs-rt
# A chave pode ser rotacionada sem aviso; por isso ela nao fica no codigo.
COLETOR_URL=

# Local: ./dados e ./logs. Na VM: /dados (block volume) e /var/log/coletor-onibus
COLETOR_DIR_DADOS=./dados
COLETOR_DIR_LOG=./logs

COLETOR_INTERVALO_S=30
COLETOR_TIMEOUT_S=15
COLETOR_BACKOFF_MAX_S=300
COLETOR_ALERTA_SEM_ARQUIVO_MIN=10
COLETOR_CONTATO=https://github.com/gustavohenriqq

# Alerta pelo Telegram (token do @BotFather e id do seu chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: URL de ping de um servico externo (ex.: healthchecks.io)
HEALTHCHECK_URL=
