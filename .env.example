# Copie para .env e preencha. O .env nunca vai para o Git.

# Feed vehicle-positions da PBH. Copie a URL completa, com a chave, do recurso
# "vehicle-positions" em https://dados.pbh.gov.br/dataset/gtfs-rt
# A chave pode ser rotacionada sem aviso; por isso ela nao fica no codigo.
COLETOR_URL=

# Local: ./dados e ./logs. Na VM: /dados (block volume) e /var/log/coletor-onibus
COLETOR_DIR_DADOS=./dados
COLETOR_DIR_LOG=./logs

COLETOR_INTERVALO_S=30
COLETOR_TIMEOUT_S=15
COLETOR_BACKOFF_MAX_S=300
COLETOR_ALERTA_SEM_ARQUIVO_MIN=10
COLETOR_ALERTA_FEED_PARADO_MIN=10
COLETOR_CONTATO=https://github.com/gustavohenriqq

# Opcional: URL de ping de um servico externo (ex.: healthchecks.io), uma por job
HEALTHCHECK_URL=
HEALTHCHECK_COMPACTACAO_URL=
HEALTHCHECK_BACKUP_URL=
# Check coletor-eventos: o vigia pinga ok a cada 5 min e /fail com o motivo
# (sem arquivo, HTTP 401/403, falha de disco, feed parado com status 200)
HEALTHCHECK_EVENTOS_URL=
# Na VM de processamento: a DAG horaria do Airflow pinga no fim e manda /fail
HEALTHCHECK_PROCESSAMENTO_URL=

# Compactacao horaria (fase 1). Os padroes abaixo sao os de producao.
COMPACTACAO_FOLGA_MIN=20
COMPACTACAO_QUARENTENA_H=48
COMPACTACAO_NIVEL_ZSTD=10

# Backup: URL pre-autenticada (PAR) do bucket, com leitura e escrita, terminando
# em /o/. E segredo: quem tem a URL le e grava no bucket.
BACKUP_PAR_URL=
BACKUP_FOLGA_H=2
